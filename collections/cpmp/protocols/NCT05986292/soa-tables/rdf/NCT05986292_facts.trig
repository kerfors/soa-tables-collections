    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c002,
            e:u-t01-c003 ;
        st:text "Screening assessments may be conducted at other time points prior to randomization if they reduce participant burden." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToColumn e:u-t01-c002 ;
        st:text "The site determines the half-life of each pain medication the participant is currently taking to schedule Visit 2. Visit 2 can be scheduled no earlier than 7 days prior to randomization at Visit 3 due to the required 7-day PDEP." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToColumn e:u-t01-c003 ;
        st:text "The 5-half-life washout period for pain medications must come before the required 7-day PDEP, resulting in a minimum of 10 days for most participants." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-d ;
        st:refersToActivity e:u-t01-r014,
            e:u-t01-r015,
            e:u-t01-r017,
            e:u-t01-r018,
            e:u-t01-r030,
            e:u-t01-r031,
            e:u-t01-r032,
            e:u-t01-r034,
            e:u-t01-r035,
            e:u-t01-r036,
            e:u-t01-r037,
            e:u-t01-r042,
            e:u-t01-r043,
            e:u-t01-r044,
            e:u-t01-r046,
            e:u-t01-r048,
            e:u-t01-r049 ;
        st:refersToCell e:m-t01-r014-t01-c003,
            e:m-t01-r015-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r018-t01-c003,
            e:m-t01-r030-t01-c003,
            e:m-t01-r031-t01-c003,
            e:m-t01-r032-t01-c003,
            e:m-t01-r034-t01-c003,
            e:m-t01-r035-t01-c003,
            e:m-t01-r036-t01-c003,
            e:m-t01-r037-t01-c003,
            e:m-t01-r042-t01-c003,
            e:m-t01-r043-t01-c003,
            e:m-t01-r044-t01-c003,
            e:m-t01-r046-t01-c003,
            e:m-t01-r048-t01-c003,
            e:m-t01-r049-t01-c003 ;
        st:text "Visit 2 testing is optional for individuals who have completed these assessments within 60 days of Visit 1. If the tests are repeated, the most recent results will be used for I/E purposes." .

    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g1 ;
        st:text "The activities applicable to all disease states and interventions studied under the master protocol are described in the SoA below." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:refersToProperty e:u-t01-r003 ;
        st:text "Visits after V7 may be specified in the ISA." .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n10 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c003 ;
        st:text "V2 procedure should be repeated if >60 days from V1" .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11 ;
        st:refersToActivity e:u-t01-r024 ;
        st:text "Collected daily with a take-home device. Compliance reviewed at each clinic visit." .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n12-d01 ;
        st:occurrence e:t01-n-n12 ;
        st:refersToActivity e:u-t01-r025 ;
        st:text "Total quantity from any source, collected daily with a take-home device. Compliance reviewed at each clinic visit. See Section 6.5. for usage guidance." .

    e:u-t01-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n13 ;
        st:refersToActivity e:u-t01-r030 ;
        st:refersToCell e:m-t01-r030-t01-c002 ;
        st:text "At V1, use the C-SSRS Baseline version." .

    e:u-t01-n-n14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n14 ;
        st:refersToActivity e:u-t01-r030 ;
        st:text "All subsequent assessments will use the C-SSRS Since Last Visit version." .

    e:u-t01-n-n15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n15 ;
        st:refersToActivity e:u-t01-r032 ;
        st:text "Complete 1 form for each event identified on the Self-Harm Supplement form." .

    e:u-t01-n-n16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n16 ;
        st:refersToActivity e:u-t01-r034,
            e:u-t01-r035,
            e:u-t01-r036,
            e:u-t01-r037,
            e:u-t01-r044,
            e:u-t01-r048,
            e:u-t01-r050 ;
        st:text "Post randomization collections will be defined in each respective ISA." .

    e:u-t01-n-n17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n17 ;
        st:refersToActivity e:u-t01-r041 ;
        st:text "For women of childbearing potential." .

    e:u-t01-n-n18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n18 ;
        st:refersToActivity e:u-t01-r041 ;
        st:refersToCell e:m-t01-r041-t01-c003 ;
        st:text "V2 test is optional if within 30 days of V1 procedure" .

    e:u-t01-n-n19 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n19 ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "Collected at screening visit for all participants and by investigator discretion after V1." .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "ISA-specific informed consent may occur after other V1 procedures and prior to beginning the medication washout if the ISA is not available at the time of initial screening." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToActivity e:u-t01-r009 ;
        st:text "Duration of washout is at least 5 half-lives of the longest half-life medication taken for pain. Recommended minimum washout duration is 2 days. If participants are not taking medication for chronic pain during screening, a washout is not required." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n4 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "7-day minimum NRS data and rescue use medication collected daily at home post washout and prior to randomization." .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5 ;
        st:refersToActivity e:u-t01-r013 ;
        st:text "Including age, gender, race, and ethnicity" .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n6 ;
        st:refersToActivity e:u-t01-r017 ;
        st:text "Pulse rate, respiratory rate, blood pressure, and temperature taken with participant in a sitting position." .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "Triplicate ECGs. Post randomization ECGs are included in each ISA." .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n8-d01 ;
        st:occurrence e:t01-n-n8 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "Any events that occur after signing the ICF are considered AEs as defined in Section 10.3." .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n9 ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "Preexisting conditions not identified at V1 and started prior to signing the ICF should be recorded." .

