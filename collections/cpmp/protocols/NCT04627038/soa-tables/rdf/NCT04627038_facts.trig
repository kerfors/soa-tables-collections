    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g1 ;
        st:text "This SoA shows visits and procedures unique to the intervention-specific appendix (ISA) H0P-MC-OA03 (OA03) for LY3556050. Please refer to master protocol CPMP and the OA DSA CPMP(1) SoAs for additional information." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:refersToProperty e:u-t01-r005 ;
        st:text """Visit window +2 days
There will be 2 telephone visits between Visit 3 and Visit 4:""" .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n10 ;
        st:refersToActivity e:u-t01-r011 ;
        st:refersToCell e:m-t01-r011-t01-c002,
            e:m-t01-r011-t01-c004,
            e:m-t01-r011-t01-c006 ;
        st:text "V3, V5, and V7: Participants take the morning dose in the clinic." .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Performed at investigator discretion" .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n12 ;
        st:refersToActivity e:u-t01-r017 ;
        st:text "For WOCBP only" .

    e:u-t01-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n13 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text """For WOCBP only
Collect sample within 24 hours prior to first dose.""" .

    e:u-t01-n-n14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n14 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c002 ;
        st:text "V3: Collect 3 hours ±15 minutes after dosing." .

    e:u-t01-n-n15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n15 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c004,
            e:m-t01-r023-t01-c006 ;
        st:text "V5 and V7: Collect samples before dosing and 3 hours ±15 minutes after dosing." .

    e:u-t01-n-n16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n16 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c003,
            e:m-t01-r023-t01-c005,
            e:m-t01-r023-t01-c007 ;
        st:text "V4, V6, and ED: Collect single sample at any time." .

    e:u-t01-n-n17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n17 ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "Record date and time of collection." .

    e:u-t01-n-n18 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t01-n-n18 ;
        st:placeholderReason "redacted" ;
        st:refersToActivity e:u-t01-r027 ;
        st:text "" .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToActivity e:u-t01-r008 ;
        st:refersToCell e:m-t01-r008-t01-c002,
            e:m-t01-r008-t01-c003,
            e:m-t01-r008-t01-c004,
            e:m-t01-r008-t01-c005,
            e:m-t01-r008-t01-c006 ;
        st:text "V3-V7: Do symptom-directed physical examination" .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToActivity e:u-t01-r009 ;
        st:refersToCell e:m-t01-r009-t01-c002,
            e:m-t01-r009-t01-c004,
            e:m-t01-r009-t01-c006 ;
        st:text "V3, V5 and V7: Single ECG before in-clinic dosing and at 3 hours after dosing" .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n4 ;
        st:refersToActivity e:u-t01-r009 ;
        st:refersToCell e:m-t01-r009-t01-c003,
            e:m-t01-r009-t01-c005,
            e:m-t01-r009-t01-c007 ;
        st:text "V4, V6 and ED: Single ECG" .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5 ;
        st:refersToActivity e:u-t01-r009 ;
        st:text "ECG includes collection of PR interval, QRS duration and interval, and heart rate." .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n6 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text """Blood Pressure
Collect orthostatic blood pressure after 5 minutes supine and then 2-3 minutes after standing and collect pulse after supine and standing blood pressure.
Temperature and Respiratory rate
Collect once at each visit""" .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r010 ;
        st:refersToCell e:m-t01-r010-t01-c002,
            e:m-t01-r010-t01-c004,
            e:m-t01-r010-t01-c006 ;
        st:text "V3, V5, and V7: Collect blood pressure and pulse in supine and standing position, before in-clinic dosing and at 3 hours after dosing" .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n8 ;
        st:refersToActivity e:u-t01-r010 ;
        st:refersToCell e:m-t01-r010-t01-c003,
            e:m-t01-r010-t01-c005,
            e:m-t01-r010-t01-c007 ;
        st:text "V4, V6 and ED: Collect blood pressure once" .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n9-d01 ;
        st:occurrence e:t01-n-n9 ;
        st:refersToActivity e:u-t01-r011 ;
        st:text """Intervention is taken orally, twice daily (BID), approximately every 12 hours.
Refer to Section 6.6 for dose titration scheme.""" .

