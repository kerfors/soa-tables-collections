        st:refersToActivity e:u-t01-r009 ;
        st:refersToCell e:m-t01-r009-t01-c004 ;
        st:text "At V3, vitals should be taken predose." .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
