        st:refersToActivity e:u-t01-r022 ;
        st:text "Complete 1 form for each event identified on the Self-Harm Supplement form." .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n12 ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "Review eDiary compliance." .

    e:u-t01-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n13 ;
        st:refersToActivity e:u-t01-r024 ;
        st:text "Review assessment of pain. See MoO for additional details." .

    e:u-t01-n-n14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n14 ;
        st:refersToActivity e:u-t01-r032 ;
        st:refersToCell e:m-t01-r032-t01-c004 ;
        st:text "For all WOCBP at V3: collect sample within 24 hours prior to dosing." .

    e:u-t01-n-n15 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-n15-d01 ;
        st:occurrence e:t01-n-n15 ;
        st:refersToActivity e:u-t01-r033 ;
        st:text "See Section 5.3.1." .

    e:u-t01-n-n16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n16 ;
        st:refersToActivity e:u-t01-r036 ;
        st:refersToCell e:m-t01-r036-t01-c004 ;
        st:text "At V3, a PK sample should be taken any time after 1 hour postdose and prior to leaving the site." .

    e:u-t01-n-n17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n17 ;
        st:refersToActivity e:u-t01-r036 ;
        st:refersToCell e:m-t01-r036-t01-c005,
            e:m-t01-r036-t01-c006,
            e:m-t01-r036-t01-c007,
            e:m-t01-r036-t01-c008,
            e:m-t01-r036-t01-c009 ;
        st:text "At V4, V5, V6, V7 and ED, a PK sample can be taken at any time during the site visit." .

    e:u-t01-n-n18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n18 ;
        st:refersToActivity e:u-t01-r036 ;
        st:text "The date and time of each PK sample collected will be recorded. The date and time of LY3857210 administration prior to the PK sample collection will be recorded." .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToActivity e:u-t01-r006 ;
        st:refersToCell e:m-t01-r006-t01-c004,
            e:m-t01-r006-t01-c009,
            e:m-t01-r006-t01-c010 ;
        st:text "Complete physical examination, including targeted examination specified below, should be performed at V3 and V801 or ED." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToActivity e:u-t01-r006 ;
        st:refersToCell e:m-t01-r006-t01-c006,
            e:m-t01-r006-t01-c008 ;
        st:text "Targeted physical examination for skin, gastrointestinal tract, mammary gland in males, and lymph nodes should also be performed at V5 and V7." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-n4-d01 ;
