    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g1 ;
        st:text "This SoA shows visits and procedures unique to the intervention-specific appendix (ISA) H0P-MC-OA02 for LY3526318. Please refer to the CPMP Master Protocol and the OA DSA H0P-MC-CPMP(1) SoAs for additional information." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n1-d01 ;
        st:occurrence e:t01-n-n1 ;
        st:refersToActivity e:u-t01-r005 ;
        st:refersToCell e:m-t01-r005-t01-c004,
            e:m-t01-r005-t01-c006,
            e:m-t01-r005-t01-c007 ;
        st:text "Symptom directed physical exam (see Section 8.2.1) at V5, V7, and ED (if applicable)." .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n10 ;
        st:refersToActivity e:u-t01-r018 ;
        st:refersToCell e:m-t01-r018-t01-c003,
            e:m-t01-r018-t01-c004,
            e:m-t01-r018-t01-c005,
            e:m-t01-r018-t01-c006 ;
        st:text "At V4, V5, V6 and V7, a sample for PK should be taken before the dose is administered; participants should be asked to refrain from taking their dose on V4-V7 until they have their clinic visit and after the blood sample is taken." .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11 ;
        st:refersToActivity e:u-t01-r018 ;
        st:refersToCell e:m-t01-r018-t01-c002,
            e:m-t01-r018-t01-c003,
            e:m-t01-r018-t01-c004,
            e:m-t01-r018-t01-c005,
            e:m-t01-r018-t01-c006 ;
        st:text "The date and time of LY3526318 administration prior to the PK sampling will be recorded, i.e., the dose administered in the clinic at V3 and the last at home dose prior to each of V4, V5, V6, and V7." .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t01-n-n12 ;
        st:placeholderReason "redacted" ;
        st:refersToActivity e:u-t01-r021 ;
        st:text "" .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToActivity e:u-t01-r006 ;
        st:refersToCell e:m-t01-r006-t01-c002 ;
        st:text "At V3, vitals should be taken predose and at approximately 2 and 4 hours post dosing." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToActivity e:u-t01-r006 ;
        st:refersToCell e:m-t01-r006-t01-c003,
            e:m-t01-r006-t01-c004,
            e:m-t01-r006-t01-c005,
            e:m-t01-r006-t01-c006 ;
        st:text "At V4, V5, V6, and V7, vitals should be taken predose." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n4 ;
        st:refersToActivity e:u-t01-r006 ;
        st:text "Pulse rate, respiratory rate, blood pressure, and temperature taken with participant in a sitting position." .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5 ;
        st:refersToActivity e:u-t01-r007 ;
        st:refersToCell e:m-t01-r007-t01-c004,
            e:m-t01-r007-t01-c006,
            e:m-t01-r007-t01-c007 ;
        st:text "Single ECGs at V5, V7, and ED (if applicable)." .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-n6-d01 ;
        st:occurrence e:t01-n-n6 ;
        st:refersToActivity e:u-t01-r008 ;
        st:text "See Section 6.1" .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r015 ;
        st:refersToCell e:m-t01-r015-t01-c002 ;
        st:text "For all WOCBP at V3: collect sample before dosing." .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-n8-d01 ;
        st:occurrence e:t01-n-n8 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "See Section 5.3.2." .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n9 ;
        st:refersToActivity e:u-t01-r018 ;
        st:refersToCell e:m-t01-r018-t01-c002 ;
        st:text "At V3, samples should be taken at 2 and 4 hours (±15 minutes) post dosing." .

