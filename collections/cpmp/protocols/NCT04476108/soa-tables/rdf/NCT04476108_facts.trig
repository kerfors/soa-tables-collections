    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g1 ;
        st:text "This SoA shows visits and procedures unique to the intervention-specific appendix (ISA) H0P-MC-NP01 (NP01) for LY3016859. Please refer to master protocol H0P-MC-CPMP (CPMP) and the diabetic peripheral neuropathic pain (DPNP) disease-state addendum (DSA) H0P-MC-CPMP(3) SoAs for additional information." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:refersToProperty e:u-t01-r004 ;
        st:text "Minimal interval between 2 doses cannot be shorter than 11 days." .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n10 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "Required if triggered by the Self-Harm Supplement Form per instructions." .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11 ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "For all premenopausal females or postmenopausal females <50 years of age" .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n12 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c002 ;
        st:text "V3: collect sample before randomization" .

    e:u-t01-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n13 ;
        st:refersToActivity e:u-t01-r026 ;
        st:refersToCell e:m-t01-r026-t01-c002,
            e:m-t01-r026-t01-c003,
            e:m-t01-r026-t01-c004,
            e:m-t01-r026-t01-c005 ;
        st:text "V3-6: collect samples before IV infusion starts and within 15 minutes after IV infusion is complete." .

    e:u-t01-n-n14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n14 ;
        st:refersToActivity e:u-t01-r026 ;
        st:refersToCell e:m-t01-r026-t01-c006,
            e:m-t01-r026-t01-c007,
            e:m-t01-r026-t01-c008,
            e:m-t01-r026-t01-c009 ;
        st:text "V7 – V803: single sample collected at any time." .

    e:u-t01-n-n15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n15 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text """Obtain PK samples from opposite arm used for IV infusion.
Record date and time of collection.""" .

    e:u-t01-n-n16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n16 ;
        st:refersToActivity e:u-t01-r027 ;
        st:refersToCell e:m-t01-r027-t01-c002,
            e:m-t01-r027-t01-c003,
            e:m-t01-r027-t01-c004 ;
        st:text "V3-6: collect sample before IV infusion starts" .

    e:u-t01-n-n17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n17 ;
        st:refersToActivity e:u-t01-r028 ;
        st:refersToCell e:m-t01-r028-t01-c002,
            e:m-t01-r028-t01-c003,
            e:m-t01-r028-t01-c004 ;
        st:text "V3-6: collect samples before IV infusion starts." .

    e:u-t01-n-n18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n18 ;
        st:refersToActivity e:u-t01-r028 ;
        st:refersToCell e:m-t01-r028-t01-c006,
            e:m-t01-r028-t01-c007,
            e:m-t01-r028-t01-c008,
            e:m-t01-r028-t01-c009 ;
        st:text "V7-V803: single sample collected at any time to match PK." .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToActivity e:u-t01-r005 ;
        st:text "Targeted exam for skin, eyes, mouth, lungs and GI tract should be performed at each visit, in addition to any symptom driven exam." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToActivity e:u-t01-r005 ;
        st:refersToCell e:m-t01-r005-t01-c009,
            e:m-t01-r005-t01-c010 ;
        st:text "Full physical exam should be performed at Visit 803 or ED." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n4 ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "Includes respiratory rate, blood pressure, temperature and pulse rate." .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5 ;
        st:refersToActivity e:u-t01-r007 ;
        st:refersToCell e:m-t01-r007-t01-c002,
            e:m-t01-r007-t01-c003,
            e:m-t01-r007-t01-c004,
            e:m-t01-r007-t01-c005 ;
        st:text "All vital signs are collected before study intervention infusion on V3-6." .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n6 ;
        st:refersToActivity e:u-t01-r008 ;
        st:text "Single safety ECGs" .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r009 ;
        st:text """1 hour IV administration
The timing between randomization and the first IV infusion may be up to, but not longer than 2 business days to reduce participant burden.""" .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n8 ;
        st:refersToActivity e:u-t01-r012,
            e:u-t01-r013,
            e:u-t01-r014,
            e:u-t01-r015 ;
        st:text "If the participant discontinues after V801, this assessment is not needed for ED per the CPMP SoA." .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n9 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Use C-SSRS Since Last Visit version." .

