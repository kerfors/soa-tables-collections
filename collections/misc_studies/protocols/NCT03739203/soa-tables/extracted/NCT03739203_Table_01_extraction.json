  "annotations": [
    {
      "annotation_marker": "a",
      "annotation_type": "footnote",
      "annotation_text": "Performed for all patients, including those prematurely discontinued after randomization (Visit 2).",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 3,
          "column_position": 7
        }
      ]
    },
    {
      "annotation_marker": "b",
      "annotation_type": "footnote",
      "annotation_text": "Clinical findings upon termination must be followed until the condition returns to prestudy status or can be explained as unrelated to investigational product. If necessary, an additional follow-up visit should be scheduled.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 3,
          "column_position": 7
        }
      ]
    },
    {
      "annotation_marker": "c",
      "annotation_type": "footnote",
      "annotation_text": "Verified Clinical Trials database check to be performed, where applicable.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 7
        }
      ]
    },
    {
      "annotation_marker": "d",
      "annotation_type": "footnote",
      "annotation_text": "Clinical laboratory tests include hematology, serum chemistry, urinalysis (including urine myoglobin in patients with creatine phosphokinase levels > 1000 U/L or as clinically indicated for any rise in creatine phosphokinase levels or as necessitated by symptoms), as well as serum pregnancy test in women of childbearing potential.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 12
        },
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 13
        }
      ]
    },
    {
      "annotation_marker": "e",
      "annotation_type": "footnote",
      "annotation_text": "Urine drug screen, blood alcohol concentration (by Breathalyzer), and serum pregnancy test can be repeated at random at request of investigator.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 12
        },
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 13
        },
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 16
        },
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 17
        }
      ]
    },
    {
      "annotation_marker": "f",
      "annotation_type": "footnote",
      "annotation_text": "Height will be measured only at Visit 1 (Screening). Waist circumference will be measured at Visits 2 and 6/ET.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 18
        }
      ]
    },
    {
      "annotation_marker": "g",
      "annotation_type": "footnote",
      "annotation_text": "SAFER/remote telephone interview will be scheduled and implemented before Visit 2 (Baseline) for patients who meet the screening criteria at Visit 1. The patient’s SAFER evaluation score should be reviewed before Visit 2 to confirm eligibility.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 22
        },
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 23
        }
      ]
    },
    {
      "annotation_marker": "h",
      "annotation_type": "footnote",
      "annotation_text": "Pharmacogenetic consent may be obtained at any time between Visit 1 (Screening) and Visit 6 (Week 6).",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 44
        }
      ]
    },
    {
      "annotation_marker": "i",
      "annotation_type": "footnote",
      "annotation_text": "Pharmacogenetic sample (1 per patient for the entire study) may be obtained from randomized patients at any time between Visit 2 (Baseline) and Visit 6 (Week 6).",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 45
        }
      ]
    },
    {
      "annotation_marker": "j",
      "annotation_type": "footnote",
      "annotation_text": "Can be taken at any time during visits 4, 5 and 6/ET.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 46
        }
      ]
    },
    {
      "annotation_marker": "k",
      "annotation_type": "footnote",
      "annotation_text": "May be up to an additional 7 days (up to 21 days) if needed with Sponsor approval.",
      "marker_locations": [
