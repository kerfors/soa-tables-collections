    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c007 ;
        st:text "Performed for all patients, including those prematurely discontinued after randomization (Visit 2)." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToColumn e:u-t01-c007 ;
        st:text "Clinical findings upon termination must be followed until the condition returns to prestudy status or can be explained as unrelated to investigational product. If necessary, an additional follow-up visit should be scheduled." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "Verified Clinical Trials database check to be performed, where applicable." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-d ;
        st:refersToActivity e:u-t01-r012,
            e:u-t01-r013 ;
        st:text "Clinical laboratory tests include hematology, serum chemistry, urinalysis (including urine myoglobin in patients with creatine phosphokinase levels > 1000 U/L or as clinically indicated for any rise in creatine phosphokinase levels or as necessitated by symptoms), as well as serum pregnancy test in women of childbearing potential." .

    e:u-t01-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-e ;
        st:refersToActivity e:u-t01-r012,
            e:u-t01-r013,
            e:u-t01-r016,
            e:u-t01-r017 ;
        st:text "Urine drug screen, blood alcohol concentration (by Breathalyzer), and serum pregnancy test can be repeated at random at request of investigator." .

    e:u-t01-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-f ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "Height will be measured only at Visit 1 (Screening). Waist circumference will be measured at Visits 2 and 6/ET." .

    e:u-t01-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g ;
        st:refersToActivity e:u-t01-r022,
            e:u-t01-r023 ;
        st:text "SAFER/remote telephone interview will be scheduled and implemented before Visit 2 (Baseline) for patients who meet the screening criteria at Visit 1. The patient’s SAFER evaluation score should be reviewed before Visit 2 to confirm eligibility." .

    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g1 ;
        st:text "Note: After completion of Visit 6/ET, patients will be treated at the discretion of the investigator or designee." .

    e:u-t01-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-h ;
        st:refersToActivity e:u-t01-r044 ;
        st:text "Pharmacogenetic consent may be obtained at any time between Visit 1 (Screening) and Visit 6 (Week 6)." .

    e:u-t01-n-i a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "Pharmacogenetic sample (1 per patient for the entire study) may be obtained from randomized patients at any time between Visit 2 (Baseline) and Visit 6 (Week 6)." .

    e:u-t01-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-j ;
        st:refersToActivity e:u-t01-r046 ;
        st:text "Can be taken at any time during visits 4, 5 and 6/ET." .

    e:u-t01-n-k a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-k ;
        st:refersToColumn e:u-t01-c002,
            e:u-t01-c003 ;
        st:text "May be up to an additional 7 days (up to 21 days) if needed with Sponsor approval." .

    e:u-t01-r001 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r001,
            e:t02-r001 ;
        st:propertyName "Study Period" ;
        st:propertyType "epoch" .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002,
            e:t02-r002 ;
        st:propertyName "Visit" ;
        st:propertyType "visit" .

    e:u-t01-r003 a st:UnifiedProperty ;
        st:level 3 ;
        st:member e:t01-r003,
            e:t02-r003 ;
        st:propertyName "Study Week" ;
        st:propertyType "week" .

    e:u-t01-r005 a st:UnifiedProperty ;
        st:member e:t01-r005 ;
        st:propertyName "Visit Windows" ;
        st:propertyType "window" .

    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToActivity e:u-t01-r012,
            e:u-t01-r013 ;
        st:text "Clinical laboratory assessments, including serum pregnancy testing (WOCBP only) may be performed at an off-site laboratory facility if needed. If patient is unable or unwilling to travel to an alternate laboratory facility, the laboratory assessment at the scheduled timepoint may be omitted. For WOCBP, study sites may provide urine pregnancy test kits for at-home testing. Study personnel should document the patient’s verbal confirmation of pregnancy test results in the source document. Patient should have clinical laboratory testing performed as an Unscheduled assessment during the Safety Follow-up period. Clinical findings upon termination must be followed until the condition returns to prestudy status or can be explained as unrelated to investigational product. If necessary, an additional follow-up visit should be scheduled." .

    e:u-t02-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-b ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "If visit is being performed remotely, this assessment may be omitted. Vital signs should be obtained at the next scheduled in-home or in-person visit." .

    e:u-t02-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c ;
        st:refersToActivity e:u-t01-r019,
            e:u-t01-r020 ;
        st:text "If visit is being performed remotely, this assessment may be omitted at this timepoint. Patient should have this assessment performed as an Unscheduled assessment during the Safety Follow-up period. Clinical findings upon termination must be followed until the condition returns to prestudy status or can be explained as unrelated to investigational product. If necessary, an additional follow-up visit should be scheduled." .

    e:u-t02-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-d ;
        st:refersToActivity e:u-t01-r036 ;
        st:text "If visit is being performed remotely, study staff should verbally administer the Short-Form 12 (SF-12) to the patient and record the patient’s responses in the source." .

    e:u-t02-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-e ;
        st:refersToActivity e:u-t01-r037 ;
        st:text "Movement scales may be conducted remotely if needed. Where possible, telemedicine virtual visits or video calls (without recording) should be used to conduct this assessment remotely. If a scale item cannot be assessed, the item may be skipped and the source should indicate the item could not be assessed. Movement scales may only be conducted by raters certified on the scale." .

    e:u-t02-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-f ;
        st:refersToActivity e:u-t01-r038 ;
        st:text "C-SSRS may be assessed remotely if needed by a certified rater. Clinicians with a valid C-SSRS certification for another Allergan study may rate C-SSRS in the event the study-certified rater is unavailable to complete the assessment." .

    e:u-t02-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-g ;
        st:refersToActivity e:u-t01-r041 ;
        st:text "As an alternative to in-person drug dispensing, IP may be dispensed via a secure delivery method (where permissible by local, statutory, federal/country law) and after approval by Sponsor." .

    e:u-t02-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-h ;
        st:refersToActivity e:u-t01-r043,
            e:u-t02-r024 ;
        st:text "Assessment of compliance should be performed at each visit. For remote visits where a pill count by site staff may not be possible, patient reported compliance is to be documented. Patient reported verification of IP capsules remaining should be documented." .

    e:u-t02-n-i a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-i ;
        st:refersToActivity e:u-t02-r026 ;
        st:text "To minimize undue burden on the patient, IP return may be less frequent during the time that visits are being conducted remotely but should occur no less frequently than monthly." .

    e:u-t02-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-j ;
        st:refersToActivity e:u-t01-r046 ;
        st:text "If visit is being performed remotely or at an alternate laboratory facility, this assessment may be omitted. In consideration of the processing time required, pharmacokinetic samples should not be collected during in-home visits." .

    e:u-t02-n-k a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-k ;
        st:refersToActivity e:u-t01-r044 ;
        st:text "Pharmacogenetic consent may be obtained at any time between Visit 1(Screening) and Visit 6 (Week 6). Pharmacogenetic consent may not be obtained remotely." .

    e:u-t02-n-l a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-l ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "Pharmacogenetic sample (1 per patient for the entire study) may be obtained from randomized patients at any time between Visit 2 (Baseline) and Visit 6 (Week 6). To be omitted if sampling is not possible due to remote visits being completed." .

    e:u-t02-n-x2a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-x2a ;
        st:refersToProperty e:u-t01-r004 ;
        st:text "Note: If necessary, Visits 3 to 7 may be conducted up to 3 days before or after the scheduled visits. The visit windows for each scheduled visit are relative to Visit 2 for Visits 3 through 7. In extenuating circumstances, the visit window for Visits 3 to 7 (inclusive) may be extended an additional 4 days (ie, +7 days) from the scheduled visit. All attempts should be made to conduct the visit within the pre-defined ± 3 day window as well as to avoid a potential lapse in IP during the extension of a visit window." .

    page:18 a st:Page ;
        st:inFile <https://kerfors.github.io/soa-tables/id/sha256/dc5e2ae3233f1b83841dfee437e3105001fb2cd63479b6edb30b0a9b9fce92c5> ;
        st:pageNumber 18 .

    page:87 a st:Page ;
        st:inFile <https://kerfors.github.io/soa-tables/id/sha256/dc5e2ae3233f1b83841dfee437e3105001fb2cd63479b6edb30b0a9b9fce92c5> ;
        st:pageNumber 87 .

    e:decision-ccorr-002 a st:Decision ;
        st:decidedAt "2026-11-22T20:05:00Z"^^xsd:dateTime ;
        st:decidedByPerson "Kerstin Forsberg" ;
        st:decisionSource e:t02-r005 ;
        st:decisionTarget e:t01-r006 ;
        st:op "keep" ;
        st:reason "Not the same activity: the COVID-19 consent/reconsent to the modified procedures (where applicable) is a separate consent from the study informed consent at screening." .

    e:decision-ccorr-003 a st:Decision ;
        st:decidedAt "2026-11-22T20:05:00Z"^^xsd:dateTime ;
        st:decidedByPerson "Kerstin Forsberg" ;
        st:decisionSource e:t02-r026 ;
        st:decisionTarget e:t01-r042 ;
        st:op "keep" ;
        st:reason "Not the same activity: Table 4 splits return and compliance into 'IP Return' and 'IP Compliance and Accountability'; 'IP Return' is only one part of Table 1's 'Drug Return and Compliance'." .

