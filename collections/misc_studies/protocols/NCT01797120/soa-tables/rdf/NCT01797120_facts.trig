    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToActivity e:u-t01-r003,
            e:u-t01-r005,
            e:u-t01-r006,
            e:u-t01-r007,
            e:u-t01-r008,
            e:u-t01-r009,
            e:u-t01-r011,
            e:u-t01-r012,
            e:u-t01-r013,
            e:u-t01-r014,
            e:u-t01-r015,
            e:u-t01-r016,
            e:u-t01-r017,
            e:u-t01-r018 ;
        st:refersToCell e:m-t01-r003-t01-c002,
            e:m-t01-r005-t01-c002,
            e:m-t01-r006-t01-c002,
            e:m-t01-r007-t01-c002,
            e:m-t01-r008-t01-c002,
            e:m-t01-r009-t01-c002,
            e:m-t01-r011-t01-c002,
            e:m-t01-r012-t01-c002,
            e:m-t01-r013-t01-c002,
            e:m-t01-r014-t01-c002,
            e:m-t01-r015-t01-c002,
            e:m-t01-r016-t01-c002,
            e:m-t01-r017-t01-c002,
            e:m-t01-r018-t01-c002 ;
        st:text "≤ 4 weeks of randomization; if assessments required ≤ 7 days of Cycle 1 Day 1 (C1D1), they do not need to be repeated (includes labs)." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToActivity e:u-t01-r006,
            e:u-t01-r007,
            e:u-t01-r008,
            e:u-t01-r009,
            e:u-t01-r010,
            e:u-t01-r014,
            e:u-t01-r015,
            e:u-t01-r016,
            e:u-t01-r017 ;
        st:refersToCell e:m-t01-r006-t01-c003,
            e:m-t01-r007-t01-c003,
            e:m-t01-r008-t01-c003,
            e:m-t01-r009-t01-c003,
            e:m-t01-r010-t01-c003,
            e:m-t01-r014-t01-c003,
            e:m-t01-r015-t01-c003,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003 ;
        st:text "≤ 7 days prior to the start of C1D1." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToActivity e:u-t01-r006,
            e:u-t01-r007,
            e:u-t01-r008,
            e:u-t01-r009,
            e:u-t01-r010,
            e:u-t01-r014,
            e:u-t01-r015 ;
        st:refersToCell e:m-t01-r006-t01-c005,
            e:m-t01-r007-t01-c005,
            e:m-t01-r008-t01-c005,
            e:m-t01-r009-t01-c005,
            e:m-t01-r010-t01-c005,
            e:m-t01-r014-t01-c005,
            e:m-t01-r015-t01-c005 ;
        st:text "+/- 72 hour window allowed prior to D1 of each subsequent cycle after the first cycle for scheduled therapy/tests/visits. Delay due to holidays, weekends, bad weather or other unforeseen circumstances will be permitted." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-d ;
        st:refersToActivity e:u-t01-r014 ;
        st:refersToCell e:m-t01-r014-t01-c004,
            e:m-t01-r014-t01-c005,
            e:m-t01-r014-t01-c007 ;
        st:text "In the event of grade 3 or 4 hematologic toxicity, CBC with differential and platelet count will be obtained every 1-3 days until there is evidence of hematologic recovery." .

    e:u-t01-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-e ;
        st:refersToActivity e:u-t01-r016,
            e:u-t01-r017 ;
        st:refersToCell e:m-t01-r016-t01-c005,
            e:m-t01-r016-t01-c006,
            e:m-t01-r016-t01-c007,
            e:m-t01-r017-t01-c005,
            e:m-t01-r017-t01-c006,
            e:m-t01-r017-t01-c007 ;
        st:text "+/- 72 hours prior to Cycle 2 Day 1 then approximately every 12 weeks during treatment (and more frequently as clinically indicated), and at end of treatment." .

    e:u-t01-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-f-d01,
            e:u-t01-n-f-d02 ;
        st:occurrence e:t01-n-f ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r019,
            e:u-t01-r020 ;
        st:refersToCell e:m-t01-r018-t01-c002,
            e:m-t01-r019-t01-c003,
            e:m-t01-r019-t01-c005,
            e:m-t01-r020-t01-c003,
            e:m-t01-r020-t01-c005 ;
        st:text "All patients should be screened for hepatitis risk factors and any past illnesses of hepatitis B and hepatitis C infection (see Section 7.1.1). All patients with a positive medical history per Section 7.1.1 need hepatitis testing as noted on above table. It is highly recommended that patients positive for HBV-DNA or HBsAg are treated prophylactically with an antiviral (e.g., Lamivudine) for 1-2 weeks prior to receiving study drug (see Table 5-3). The antiviral treatment should continue throughout the entire study period and for at least 4 weeks after the last dose of everolimus." .

    e:u-t01-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-g-d01 ;
        st:occurrence e:t01-n-g ;
        st:refersToActivity e:u-t01-r019 ;
        st:refersToCell e:m-t01-r019-t01-c003,
            e:m-t01-r019-t01-c005 ;
        st:text "Patients on antiviral prophylaxis treatment or positive HBV antibodies should be tested for HBV-DNA ≤ 7 days prior to the start of C1D1 and +/- 72 hrs prior to D1 of each subsequent cycle to monitor for reactivation. See Table 5-4 for reactivation instructions." .

    e:u-t01-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-h-d01 ;
        st:occurrence e:t01-n-h ;
        st:refersToActivity e:u-t01-r020 ;
        st:refersToCell e:m-t01-r020-t01-c003,
            e:m-t01-r020-t01-c005 ;
        st:text "Patients with positive HCV RNA-PCR results at screening and/or a history of past infection (even if treated and considered ‘cured’) should have HCV RNA-PCR testing performed on ≤ 7 days prior to the start of C1D1 and +/- 72 hrs prior to D1 of each subsequent cycle to monitor for flare. Everolimus must be discontinued if HCV flare is confirmed according to the guidance in Table 5-5." .

    e:u-t01-n-i a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i ;
        st:refersToActivity e:u-t01-r011 ;
        st:refersToCell e:m-t01-r011-t01-c002,
            e:m-t01-r011-t01-c006,
            e:m-t01-r011-t01-c007,
            e:m-t01-r011-t01-c008,
            e:m-t01-r011-t01-c009 ;
        st:text "Tumor measurements may be made using physical examination, CT Scans or MRI. Tumor assessments will be performed every 12 weeks, +/- 1 week (every 3 months). Imaging will include chest and abdomen. Bone Scans and Brain CT/MRI may be performed as clinically indicated. Scans do not have to be repeated once disease progression is documented." .

    e:u-t01-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-j ;
        st:refersToActivity e:u-t01-r010 ;
        st:refersToCell e:m-t01-r010-t01-c007,
            e:m-t01-r010-t01-c008,
            e:m-t01-r010-t01-c009 ;
        st:text "Adverse events related to fulvestrant and/or everolimus/placebo will be followed for 30 days after the last dose of study therapy (fulvestrant and/or everolimus/placebo) or until ≤ grade 1 or if the grade is >1, the event must be permanent and stable. Please note- Serious adverse events >30 days after last dose of fulvestrant and/or everolimus/placebo are not reported unless the event may be related to everolimus/placebo." .

    e:u-t01-n-k a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-k ;
        st:refersToActivity e:u-t01-r014,
            e:u-t01-r015,
            e:u-t01-r016,
            e:u-t01-r017,
            e:u-t01-r019,
            e:u-t01-r020 ;
        st:refersToCell e:m-t01-r014-t01-c008,
            e:m-t01-r015-t01-c008,
            e:m-t01-r016-t01-c008,
            e:m-t01-r017-t01-c008,
            e:m-t01-r019-t01-c008,
            e:m-t01-r020-t01-c008 ;
        st:text "CBC and chemistry may be used to assess ongoing toxicity but are not required in the Continuation Phase for patients who receive fulvestrant alone. Patients who continue fulvestrant with everolimus should periodically have CBC, chemistries, fasting glucose, fasting lipids, HBV DNA, HCV RNA-PCR per labeling guidelines." .

    e:u-t01-n-l a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-l ;
        st:refersToActivity e:u-t01-r021 ;
        st:refersToCell e:m-t01-r021-t01-c008 ;
        st:text "Study Drug Compliance (Pill Diary) for those patients who receive everolimus in the Continuation Phase." .

    e:u-t01-n-m a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-m ;
        st:refersToActivity e:u-t01-r011 ;
        st:refersToCell e:m-t01-r011-t01-c009 ;
        st:text "All patients including those that discontinue protocol therapy will be followed for 3 years from the time of randomization. Patients that have not progressed during the Induction or Continuation Phase will continue to have imaging scans completed every 12 weeks, +/- 1 week (every 3 months) until documented progression." .

    e:u-t01-n-n a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "PFTs with DLCO as medically indicated only, (PFTs are not otherwise required during course of study)." .

    e:u-t01-n-o a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-o ;
        st:refersToActivity e:u-t01-r011 ;
        st:refersToCell e:m-t01-r011-t01-c009 ;
        st:refersToColumn e:u-t01-c009 ;
        st:text "Follow every 3 months for disease progression and survival. Initiation of any new systemic therapy will also be documented." .

    e:u-t01-n-pr1 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-pr1-d01 ;
        st:occurrence e:t01-n-pr1 ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "see Appendix C" .

    e:u-t01-n-pr2 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-pr2-d01 ;
        st:occurrence e:t01-n-pr2 ;
        st:refersToColumn e:u-t01-c007 ;
        st:text "Section 5.6" .

    e:u-t01-n-x2a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a ;
        st:refersToColumn e:u-t01-c003,
            e:u-t01-c005 ;
        st:text "Cycle 1, Day 1 is defined as the first day on which fulvestrant is given in combination with placebo/everolimus (the second fulvestrant dose is given on day 15 of the first cycle only). Day 1 of each additional cycle is defined as the day in which fulvestrant is given in combination with everolimus/placebo." .

    e:u-t01-n-x5e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x5e ;
        st:refersToColumn e:u-t01-c007 ;
        st:text "End of Induction/End of Treatment should be performed within 30 days of last dose of fulvestrant." .

    e:u-t01-n-xa3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-xa3 ;
        st:refersToColumn e:u-t01-c008 ;
        st:text "Continuation Phase: Patients in the Continuation Phase should continue to receive fulvestrant alone (if originally randomized to placebo) or in combination with everolimus (if originally randomized to everolimus) at the same dose and schedule (+/- 1 week window for scheduled therapy/tests/visits; delays due to holidays, weekends, bad weather or other unforeseen circumstances will be permitted) until disease progression or unacceptable toxicity." .

    e:u-t01-r001 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r001 ;
        st:propertyName "Phase" ;
        st:propertyType "epoch" .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002 ;
        st:propertyName "Visit / Occasion" ;
        st:propertyType "timepoint" .

