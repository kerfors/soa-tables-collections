    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c002 ;
        st:text "Screening, randomization and intake of first study drug must occur within 48 hours of symptom onset." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToColumn e:u-t01-c014 ;
        st:text "The visit can be performed at a later time point if participant on inpatient rehabilitation facility and this visit cannot be arranged." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToActivity e:u-t01-r016 ;
        st:refersToCell e:m-t01-r016-t01-c002 ;
        st:refersToColumn e:u-t01-c015 ;
        st:text "Participants will perform their safety follow-up phone call 2 weeks after the EOT visit or the ET visit whichever occurs earlier. (i.e. in case of Early Termination 2 weeks after last study drug intake)." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-d ;
        st:refersToActivity e:u-t01-r010,
            e:u-t01-r013,
            e:u-t01-r015,
            e:u-t01-r016,
            e:u-t01-r017,
            e:u-t01-r024 ;
        st:refersToCell e:m-t01-r010-t01-c003,
            e:m-t01-r013-t01-c003,
            e:m-t01-r015-t01-c003,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r024-t01-c003 ;
        st:text "In case screening and randomization are performed on the same day, this procedure does not need to be repeated." .

    e:u-t01-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-e ;
        st:refersToActivity e:u-t01-r013 ;
        st:refersToCell e:m-t01-r013-t01-c004,
            e:m-t01-r013-t01-c006,
            e:m-t01-r013-t01-c008,
            e:m-t01-r013-t01-c010,
            e:m-t01-r013-t01-c012 ;
        st:text "At Visit 3, 5, 7, 9 and 11: any new concomitant medication and AEs or outcome event will be captured during the calls." .

    e:u-t01-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-f-d01,
            e:u-t01-n-f-d02 ;
        st:occurrence e:t01-n-f ;
        st:refersToActivity e:u-t01-r015 ;
        st:refersToCell e:m-t01-r015-t01-c007 ;
        st:text "modified Ranking Score (mRS) (Section 10.10) and NIHSS (Section 10.11) should be assessed as follows: Index event: at time of screening and time of randomization (NIHSS), day 7 after the event (or at hospital discharge, if this occurs before day 7; NIHSS and mRS), at 3, 6 and 12 months visits (mRS). For recurrent stroke events: maximum score during hospitalization (NIHSS), day 7 after the event (or at hospital discharge, if this occurs before day 7: NIHSS and mRS); visit closest to 3 months after recurrent stroke (mRS)." .

    e:u-t01-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g ;
        st:refersToActivity e:u-t01-r016 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "ECG machine that automatically calculates the heart rate and measures PR, QRS, QT and QTc intervals should be used." .

    e:u-t01-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-h-d01 ;
        st:occurrence e:t01-n-h ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "outcome events including all bleeding, death, MI, recurrent stroke and systemic embolism as well as events indicative of a potential outcome (Section 10.1.5.4) need to be reported on dedicated forms in the eCRF on an ongoing basis, even if the participant is permanently discontinued from study treatment." .

    e:u-t01-n-i a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "MRI is required before or latest within 72 after randomization." .

    e:u-t01-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-j ;
        st:refersToActivity e:u-t01-r020 ;
        st:refersToCell e:m-t01-r020-t01-c007 ;
        st:text "For part A only until Part B starts." .

    e:u-t01-n-k a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-k ;
        st:refersToActivity e:u-t01-r024 ;
        st:refersToCell e:m-t01-r024-t01-c002,
            e:m-t01-r024-t01-c003 ;
        st:text "Creatinine, eGFR results, AST and ALT values measured in the local laboratory for screening. Current local laboratory results available for the index hospitalization for the stroke can be used. Full safety laboratory assessments to be done at randomization in the central laboratory." .

    e:u-t01-n-l a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-l-d01 ;
        st:occurrence e:t01-n-l ;
        st:refersToActivity e:u-t01-r030,
            e:u-t01-r031,
            e:u-t01-r033,
            e:u-t01-r036 ;
        st:text "Refer to Table 1–1 PK, PD and Biomarker sampling." .

    e:u-t01-n-m a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-m-d01 ;
        st:occurrence e:t01-n-m ;
        st:refersToActivity e:u-t01-r034,
            e:u-t01-r035,
            e:u-t01-r036,
            e:u-t01-r037 ;
        st:text "“Study drug” refers to “study intervention’ as defined in Section 6.1." .

    e:u-t01-n-n a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n ;
        st:refersToActivity e:u-t01-r035 ;
        st:refersToCell e:m-t01-r035-t01-c003,
            e:m-t01-r035-t01-c007,
            e:m-t01-r035-t01-c009,
            e:m-t01-r035-t01-c011 ;
        st:text "At each contact, participants should be again instructed regarding study drug compliance." .

    e:u-t01-r001 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r001,
            e:t02-r001 ;
        st:propertyName "Study periods" ;
        st:propertyType "epoch" .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:member e:t01-r002 ;
        st:propertyName "Duration" ;
        st:propertyType "other" .

    e:u-t01-r003 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r003,
            e:t02-r002 ;
        st:propertyName "Visit number" ;
        st:propertyType "visit" .

    e:u-t01-r004 a st:UnifiedProperty ;
        st:member e:t01-r004 ;
        st:propertyName "Visit type" ;
        st:propertyType "modality" .

    e:u-t01-r005 a st:UnifiedProperty ;
        st:level 3 ;
        st:member e:t01-r005 ;
        st:propertyName "Week [W] Study day and allowed deviations" ;
        st:propertyType "week" .

    e:u-t01-r014 a st:UnifiedActivity ;
        st:displayOrder 9 ;
        st:hierarchyLevel 0 ;
        st:isSectionHeader true ;
        st:matchConfidence 1.0 ;
        st:matchStatus "new" ;
        st:member e:t01-r014 ;
        st:name "Clinical procedures / assessments" ;
        st:parentName "" ;
        st:qualifiedKey "::Clinical procedures / assessments" .

    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToColumn e:u-t02-c003,
            e:u-t02-c004,
            e:u-t02-c005 ;
        st:text "At Visit 4: in order to collect pre-dose samples for PK and PD, participants should take their study drug at the site only after blood sampling. The investigator must record the time when the study drug is taken at the site. A phone call to remind the participants is recommended." .

    e:u-t02-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-b ;
        st:refersToColumn e:u-t02-c005,
            e:u-t02-c006 ;
        st:text "The minimum time between the 2-4 h post-dose and the 4-12 h post-dose samples, if collected the same day, should be at least 1 hour." .

    e:u-t02-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c ;
        st:refersToColumn e:u-t02-c006 ;
        st:text "The late sample 4-12 hr post-dose can be taken at week 4 (visit 4) or at a later-on visit (e.g. Visit 6). The exact time of when the study drug was administered must be recorded as well as PK and PD post-dose sample collection time." .

    e:u-t02-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-d ;
        st:refersToColumn e:u-t02-c007 ;
        st:text "At Visit 8 (week 26) in order to collect pre-dose samples for PK and PD, participants should take their study drug at the site only after blood sampling. The investigator must record the time when the study drug is taken at the site. A phone call to remind the participants is recommended. However, in case Visit 8 is also the EOT visit as well as in case the sample is taken at ET visit, no study drug will be administered." .

    e:u-t02-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-e-d01 ;
        st:occurrence e:t02-n-e ;
        st:refersToActivity e:u-t02-r003,
            e:u-t02-r004 ;
        st:text "If study drug is temporarily stopped, PK / PD blood samples should only be obtained if study drug has been restarted and sustained for at least 4 days, see Section 7.1.1." .

    e:u-t02-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n1 ;
        st:refersToActivity e:u-t02-r003,
            e:u-t02-r004,
            e:u-t02-r005,
            e:u-t02-r006 ;
        st:text "The exact times of PK, PD and biomarker sampling need to be recorded, as well as the time of the most recent study drug intake (i.e: on the PK / PD sampling day, as well as the day before that)." .

