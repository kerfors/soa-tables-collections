  "annotations": [
    {
      "annotation_marker": "1",
      "annotation_type": "footnote",
      "annotation_text": "First study drug administration should be one day after the last baseline assessment.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 2,
          "column_position": 3
        }
      ]
    },
    {
      "annotation_marker": "2",
      "annotation_type": "footnote",
      "annotation_text": "Physical examination includes weight, heart and respiratory rate, and body temperature.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 11
        }
      ]
    },
    {
      "annotation_marker": "3",
      "annotation_type": "footnote",
      "annotation_text": "All women will have serum pregnancy tests performed at screening and baseline. A urine pregnancy test will also be done at baseline prior to randomization. All women of childbearing potential will have serum and urine pregnancy tests at each subsequent visit.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 12
        }
      ]
    },
    {
      "annotation_marker": "4",
      "annotation_type": "footnote",
      "annotation_text": "The same salivary or tear sample is used for volume and biomarker assessments (see Section 4.6.1.3.4.).",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 19
        },
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 21
        }
      ]
    },
    {
      "annotation_marker": "5",
      "annotation_type": "footnote",
      "annotation_text": "Only markers required for ESSDAI scoring will be collected.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 24,
          "column_position": 8
        },
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 24,
          "column_position": 9
        }
      ]
    },
    {
      "annotation_marker": "6",
      "annotation_type": "footnote",
      "annotation_text": "Safety laboratory assessment consists of hematology, blood chemistry, coagulation, lipids and urinalysis.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "activity_name",
          "row_position": 30
        }
      ]
    },
    {
      "annotation_marker": "7",
      "annotation_type": "footnote",
      "annotation_text": "MSG biopsies procedures for the optional substudy may be performed at separate study center visits providing the procedures are carried out within the windows specified for the main study.",
      "marker_locations": [
        {
          "table_number": 1,
          "location_type": "schedule_cell",
          "row_position": 33,
          "column_position": 7
        }
      ]
    },
    {
      "annotation_marker": "8",
      "annotation_type": "footnote",
      "annotation_text": "Screening, baseline and on-treatment visit schedules are all relative to the first day of study drug administration (Day 1). The follow-up visit is scheduled relative to the Week 12 end-of-treatment visit (+14 days after the end-of-treatment visit [± 7 days]).",
      "marker_locations": [
