            e:u-t01-c009,
            e:u-t01-c010,
            e:u-t01-c011,
            e:u-t01-c012,
            e:u-t01-c013,
            e:u-t01-c014,
            e:u-t01-c015,
            e:u-t01-c016,
            e:u-t01-c017,
            e:u-t01-c018,
            e:u-t01-c019 ;
        st:text "For early terminations that occur before the last visit in treatment period, see the activities listed for ET in this table. Shaded columns represent the dose escalation period Weeks 0-16." .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n10 ;
        st:refersToActivity e:u-t01-r037 ;
        st:refersToCell e:m-t01-r037-t01-c020 ;
        st:text "The Participant Survey should be administered at early termination if it occurs before 26 weeks." .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11 ;
        st:refersToActivity e:u-t01-r049,
            e:u-t01-r050,
            e:u-t01-r051 ;
        st:text "Collect serum estradiol, FSH, and LH in women whose menopausal status needs to be determined. For participants known to be either premenopausal or postmenopausal, these tests do not need to be collected." .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n12 ;
        st:refersToActivity e:u-t01-r068,
            e:u-t01-r069 ;
        st:text """PK predose sample should be collected predose (~up to 1 hour predose).
PK postdose sample time windows: 3-6 hours postdose (Week 4); 6-12 hours postdose (Week 8), 1-3 hours postdose (Week 16), 3-6 hours postdose (Week 26).
Participants may need to return to clinical site for additional PK-specific visits to provide postdose PK samples.""" .

    e:u-t01-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n13 ;
        st:refersToActivity e:u-t01-r075 ;
        st:text "One bottle of capsules is to be dispensed at Visit 3 and at Visit 4. Two bottles of capsules are to be dispensed at Visits 5-9 (during the rest of the dose escalation period). The site pharmacy should clearly label which bottle to take first. At Visits 10-17, 4 bottles of capsules should be dispensed." .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n2-d01 ;
        st:occurrence e:t01-n-n2 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "Vital signs include pulse rate, blood pressure, and temperature. Vital sign measurements should be collected after participant has been sitting for at least 5 minutes and before obtaining an ECG tracing and before collection of blood samples for laboratory testing (see Section 10.7)." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToActivity e:u-t01-r021 ;
        st:text "As indicated based on participant status and standard of care. May be performed by qualified personnel per local regulations." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n4-d01 ;
        st:occurrence e:t01-n-n4 ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "Single central ECGs will be performed at screening and early termination. Central ECGs should be collected in triplicate at all other visits. ECG should be collected prior to collection of blood samples, including PK samples. ECG measurements should be obtained per the instructions in Section 8.2.3." .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5 ;
        st:refersToActivity e:u-t01-r025 ;
        st:text "Participants should return the ABPM device at the conclusion of the 24- to 27-hour monitoring period." .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n6 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text "At the time participant visit data are uploaded by the site, the ABPM Data Validity Report will be generated and should be reviewed to ensure ≥70% of readings are valid. If <70% of readings are valid, the 24-hour monitoring session should be repeated within the visit window." .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r028 ;
        st:text "May be performed more frequently based on usual site practices and participant needs." .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n8 ;
        st:refersToActivity e:u-t01-r029 ;
        st:text "May be performed based on participant needs." .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n9 ;
        st:refersToActivity e:u-t01-r031 ;
        st:text "The date and time of all dose administrations will be recorded in the log by the participant the day prior to a study visit, but may be recorded more frequently depending on site usual practice." .

