    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-g1-d01 ;
        st:occurrence e:t01-n-g1,
            e:t02-n-g1 ;
        st:text "Alternative study measures during the COVID-19 Pandemic and for Extenuating Circumstances is described in Appendix 13." .

    e:u-t01-n-g2 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g2 ;
        st:text "Unscheduled visits may be necessary during the study for safety monitoring or to repeat any blood sampling if required." .

    e:u-t01-n-g3 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g3 ;
        st:text "Mobile phlebotomy/home health services may be utilized for Pre-Dose LFT blood draws and most blood collections after Study Day 1/Visit 3 infusion, as needed. Additionally, mobile phlebotomy/home health service may be utilized, prior to Visit 3, upon sponsor approval, except for pre-dose LFT blood draws which do not require sponsor approval." .

    e:u-t01-n-g4 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g4,
            e:t02-n-g4 ;
        st:text "Early discontinuation visit should follow the procedures for Week 312 visit. The management of the participant and the risks inherent with discontinuation from the study should be discussed with the sponsor’s medical monitor." .

    e:u-t01-n-g5 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g5 ;
        st:text "Note: Study Site: Will screen and follow study participants post-infusion of PF-06838435 for the duration of the study. Some study sites may be approved to carry out infusions within their institution." .

    e:u-t01-n-g6 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g6 ;
        st:text "Infusion Center: A site, external from the study site, approved for the administration of PF-06838435." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:refersToColumn e:u-t01-c002 ;
        st:text "The following Screening labs should be collected in the absence of residual infused FIX (FIX trough): FIX activity, hemostasis markers, inhibitor testing." .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n10-d01 ;
        st:occurrence e:t01-n-n10 ;
        st:refersToActivity e:u-t01-r010 ;
        st:refersToCell e:m-t01-r010-t01-c002 ;
        st:text "Weight must be obtained at Screening Visit to order the correct quantity of IP. Weight at Screening Visit (Visit 1) will be used to calculate the dose (Section 8.2.1)." .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11 ;
        st:refersToActivity e:u-t01-r010 ;
        st:refersToCell e:m-t01-r010-t01-c004 ;
        st:text "Vital signs (at Day 1) will be obtained: • prior to FIX infusion; • 30±2 mins after the start of IP infusion (taken during infusion); • approximately 2 mins, 2 hrs ±10 mins, 6 hrs ±10 mins, and 24 (±3) hrs after completion of IP infusion and IV line flush." .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n12,
            e:t02-n-n2 ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "12-lead ECG will be obtained for the study. Additional ECGs may be obtained as clinically indicated." .

    e:u-t01-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n13-d01 ;
        st:occurrence e:t01-n-n13 ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "See Appendix 7 for definition of a target joint. Done as part of hemophilia history." .

    e:u-t01-n-n14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n14 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "Hepatitis: HBsAg, HBcAb, HBV-deoxyribonucleic acid (DNA); HCV-RNA Quantitative Liver fibrosis: FibroScan, FibroTest/FibroSURE, or AST to platelet ratio index (APRI). HIV: Antibody testing, and CD4 count/HIV viral load (if antibody positive). Urinalysis: pH, specific gravity, protein, blood, ketones, glucose." .

    e:u-t01-n-n15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n15,
            e:t02-n-n3 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "To be tested as biomarker for hepatic carcinoma." .

    e:u-t01-n-n16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n16 ;
        st:refersToActivity e:u-t01-r024 ;
        st:text "These specimens should be collected in the absence of residual infused FIX. Nijmegen Bethesda Inhibitor assay at the central lab unless testing at a local lab is necessary due to a clinical concern." .

    e:u-t01-n-n17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n17 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text "Anti-PF-06838435 antibodies (ADA) from human serum." .

    e:u-t01-n-n18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n18 ;
        st:refersToActivity e:u-t01-r027 ;
        st:text "• Hematology: WBC and differential, RBC, hemoglobin, hematocrit, and platelet count. • Chemistry: Na, K, Cl, phosphate, bicarbonate, glucose, BUN, serum creatinine." .

    e:u-t01-n-n19 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n19 ;
        st:refersToActivity e:u-t01-r027 ;
        st:refersToCell e:m-t01-r027-t01-c002 ;
        st:text "ABO blood group (CL) (at Screening if unknown)." .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToColumn e:u-t01-c002,
            e:u-t01-c003 ;
        st:text "The Screening and Baseline period may be extended, upon consultation with the sponsor’s medical monitor. Reason must be recorded in the source documents. Depending on the length of extension (of either period), the medical monitor may request to have visit procedures repeated." .

    e:u-t01-n-n20 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n20-d01 ;
        st:occurrence e:t01-n-n20 ;
        st:refersToActivity e:u-t01-r028 ;
        st:text "These specimens are to be drawn after at least 8 hours of fasting (Appendix 2)." .

    e:u-t01-n-n21 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n21 ;
        st:refersToActivity e:u-t01-r032 ;
        st:text "• LFT: albumin, total bilirubin, direct bilirubin, indirect bilirubin (if available), ALP, AST, ALT, total protein, GGT, LDH. • FIX:C, FIX Ag. • FIX Activity should be collected in the absence of residual infused FIX. • For first 12 weeks, 2 or 3 times every week monitoring will be conducted due to potential rise in hepatic transaminases and/or loss of FIX transgene expression. • Sponsor recommends collecting specimens on Mondays through Thursdays so that the results are available prior to the weekend." .

    e:u-t01-n-n22 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n22 ;
        st:refersToActivity e:u-t01-r033 ;
        st:refersToCell e:m-t01-r033-t01-c003 ;
        st:text "IP is to be ordered at the beginning of the Baseline Period after confirming eligibility criteria." .

    e:u-t01-n-n23 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n23-d01,
            e:u-t01-n-n23-d02 ;
        st:occurrence e:t01-n-n23 ;
        st:refersToActivity e:u-t01-r033 ;
        st:text "The IP will take approximately 3 weeks for delivery. Prior to ordering IP, Sections 10.13.3 and 10.13.4 should be considered." .

    e:u-t01-n-n24 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n24 ;
        st:refersToActivity e:u-t01-r037 ;
        st:text "• Specimens for PBMC by ELISPOT are to be collected at Baseline and if the corticosteroid treatment is needed for a suspected T-cell response. • Specimens are to be collected prior to initiating the corticosteroid treatment. If not collected prior to initiation, specimens must be collected within 24 hours of administering corticosteroids. • It is highly recommended that participants who are initiated on corticosteroid treatment be treated with a gastric acid reducer, preferably a proton pump inhibitor (PPI) (eg, omeprazole), or alternatively a histamine type 2 (H2) antagonist (eg, ranitidine) for the duration of the corticosteroid course. • Specimens are to be collected approximately 3 weeks after steroid administration. Additional specimens may be necessary if ELISPOT has not normalized at 3 weeks and/or based on medical judgement." .

    e:u-t01-n-n25 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n25 ;
        st:refersToActivity e:u-t01-r038 ;
        st:text "Utilize mobile phlebotomy/ home health services, as needed and if possible. Collect blood for PBMC preparation for cell-mediated exploratory immunology assays." .

    e:u-t01-n-n26 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n26 ;
        st:refersToActivity e:u-t01-r042 ;
        st:text "Serum samples will be used for these tests. Post-dose samples will be collected on Week 1 and Week 2." .

    e:u-t01-n-n27 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n27,
            e:t02-n-n9 ;
        st:refersToActivity e:u-t01-r043 ;
        st:text "Approximately 5 mL of blood will be drawn to provide approximately 2 mL of plasma, each time blood is collected for central laboratory samples. The plasma will be stored for repeat or additional testing. These samples will be destroyed at the end of the study." .

    e:u-t01-n-n28 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n28-d01 ;
        st:occurrence e:t01-n-n28,
            e:t02-n-n10 ;
        st:refersToActivity e:u-t01-r044 ;
        st:text "All participants will undergo liver ultrasound. Imaging will be performed locally (Section 8.2.5)." .

    e:u-t01-n-n29 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n29 ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "aPTT (in seconds), INR, TAT, TGA, and D-dimer, These specimens should be collected in the absence of residual infused FIX. The tests may be conducted as clinically indicated throughout the study." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToColumn e:u-t01-c004 ;
        st:text "After determination of eligibility, FIX replacement therapy and IP Infusion will be planned at a time when a routine FIX infusion will occur during the study visit on Day 1." .

    e:u-t01-n-n30 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n30-d01 ;
        st:occurrence e:t01-n-n30 ;
        st:refersToActivity e:u-t01-r046 ;
        st:text "Provide eDiary and training to operate it, including timing and information to be entered starting at Visit 1 (see Section 8.1.1)." .

    e:u-t01-n-n31 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n31-d01 ;
        st:occurrence e:t01-n-n31 ;
        st:refersToActivity e:u-t01-r047 ;
        st:text "Review the eDiary data (see Section 8.1.1), ensure appropriate entries, during unscheduled and scheduled visits." .

    e:u-t01-n-n32 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n32 ;
        st:refersToActivity e:u-t01-r051 ;
        st:refersToCell e:m-t01-r051-t01-c004 ;
        st:text "Blood for LFTs are to be drawn and tested locally and centrally prior to dosing participants (up to 3 days prior to Day 1/ Visit 3 is acceptable)." .

    e:u-t01-n-n33 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n33 ;
        st:refersToActivity e:u-t01-r051 ;
        st:text "Utilize mobile phlebotomy/ home health services as needed, and if possible. Local LFTs are required to be reviewed prior to thawing drug. If the investigator has any clinical concerns regarding the local LFT results, drug should not be thawed. These LFT results may help in the assessment of future LFTs and decisions on when to begin corticosteroid treatment, if necessary. These LFT results should be entered into the CRF as an unplanned visit." .

    e:u-t01-n-n34 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n34 ;
        st:refersToActivity e:u-t01-r052 ;
        st:refersToCell e:m-t01-r052-t01-c004 ;
        st:text "On Day 1 a single prophylactic IV infusion of a FIX product will be administered under medical supervision, over a period of approximately 10 minutes at a dose of 100 IU/kg for standard half-life products and 50 IU/kg for extended half-life products, within reasonable margin of error (approximately ±20%)." .

    e:u-t01-n-n35 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n35 ;
        st:refersToActivity e:u-t01-r052 ;
        st:text "If there is evidence to show that these doses may place the participant at supratherapeutic FIX levels, the dose can be adjusted. Participants are expected to bring their current Factor IX replacement therapy with them." .

    e:u-t01-n-n36 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n36-d01,
            e:u-t01-n-n36-d02 ;
        st:occurrence e:t01-n-n36 ;
        st:refersToActivity e:u-t01-r056 ;
        st:text "Prior to dosing, Section 10.13.3 and 10.13.4 should be considered. After the completion of FIX product infuion, participants will receive a single IV infusion of the IP over approximately 60 minutes via infusion pump. IP should NOT be thawed without: confirmation of eligibility, Pre-Dosing LFT results, AND affirming that the participant is physically present at the study site (or infusion center). The IV line should be flushed at the conclusion of the IP infusion." .

    e:u-t01-n-n37 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n37-d01 ;
        st:occurrence e:t01-n-n37 ;
        st:refersToActivity e:u-t01-r057 ;
        st:text "To be completed by investigator or the designee (Section 8.1.2.1)." .

    e:u-t01-n-n38 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n38-d01 ;
        st:occurrence e:t01-n-n38 ;
        st:refersToActivity e:u-t01-r058 ;
        st:text "Participants will complete 5 instruments at the site using an electronic tablet: Haem-A-QoL, Haemophilia Activities List [HAL (v2)], PGIC-H, HLIQ, and EQ-5D-5L. The questionnaires should be administered before dosing, treatment, or conversation between health care team and participants about their health condition. See Section 8.1.3 for additional considerations. Every effort should be made to conduct the PROs according to the protocol specified timepoints, especially the baseline visit. If the post-infusion PROs can’t be performed at a particular visit, they should be performed at the next visit." .

    e:u-t01-n-n39 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n39 ;
        st:refersToActivity e:u-t01-r058 ;
        st:refersToCell e:m-t01-r058-t01-c003 ;
        st:text "Baseline PRO assessments need to be done prior to start of infusion on Day 1 if not done at baseline visit." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n4 ;
        st:refersToColumn e:u-t01-c002,
            e:u-t01-c003,
            e:u-t01-c004 ;
        st:text "Study sites without necessary infusion facilities will complete Visits 1-2 at the study site and Visit 3 (Day 1) will be completed at the designated Infusion Center." .

    e:u-t01-n-n40 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n40 ;
        st:refersToActivity e:u-t01-r062 ;
        st:text "Semen samples can be collected at home the night before a clinic or mobile phlebotomy/ home health service visit and stored in the participant’s freezer until the clinic or mobile phlebotomy/ home health service visit, with the exception of semen samples collected as part of the optional vector shedding sub-study (see bullet point below)" .

    e:u-t01-n-n41 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n41,
            e:t02-n-n16 ;
        st:refersToActivity e:u-t01-r063 ;
        st:text "Additional laboratory testing may be conducted as deemed clinically necessary by the investigator to ensure safety of participants." .

    e:u-t01-n-n42 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n42-d01 ;
        st:occurrence e:t01-n-n42 ;
        st:refersToActivity e:u-t01-r064 ;
        st:text "During the Short-Term Monitoring Period (up to and including 52 weeks post-infusion) all SAEs and AEs (including medically important events) will be collected (Appendix 3)." .

    e:u-t01-n-n43 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n43-d01 ;
        st:occurrence e:t01-n-n43 ;
        st:refersToActivity e:u-t01-r068 ;
        st:text "All concomitant therapy 30 days prior to Screening, during Screening and Short-Term Monitoring Period will be recorded up to and including 52 weeks post-infusion as per Section 6.5. All procedures and surgeries (including elective surgeries) during the Screening and Short-Term Monitoring Period are to be recorded." .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5 ;
        st:refersToColumn e:u-t01-c004 ;
        st:text "Day 1: All eligible participants will be dosed on Day 1 and are required to return to the infusion center or study site 24 hours after being dosed (on Day 2) to have their vital signs assessed." .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n6 ;
        st:refersToProperty e:u-t01-r003 ;
        st:text "The schedule of assessments should be based on Day 1" .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r004 ;
        st:text "Must be obtained from participants prior to any study-related procedures. Two ICFs may be required, one from the Study Site and the other from the Infusion Center (if applicable)." .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n8-d01,
            e:u-t01-n-n8-d02 ;
        st:occurrence e:t01-n-n8 ;
        st:refersToActivity e:u-t01-r006 ;
        st:text "All ongoing AEs and SAEs in the lead-in study (C0371004) including events of special interest, as defined in the lead-in study (C0371004), will be collected as medical history for this study. Only changes to historical data on Demographics, Medical, Surgical and Hemophilia History will be captured. Any new AEs/SAEs after completion of the lead-in study will follow the AE reporting process (Section 8.3.1, Appendix 3)." .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n9-d01 ;
        st:occurrence e:t01-n-n9 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "Complete Physical Exam at all clinic visits (Height is required to be collected at Screening Visit). Vital signs include: body temperature (°C) (see Section 8.2.2), BP, pulse rate, respiratory rate, after at least 5 mins rest in supine or upright/sitting position. Vital signs are to be measured as specified below." .

    e:u-t01-n-x23-r005 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-x23-r005-d01,
            e:u-t01-n-x23-r005-d02 ;
        st:occurrence e:t01-n-x23-r005 ;
        st:refersToActivity e:u-t01-r005 ;
        st:refersToCell e:m-t01-r005-t01-c004,
