            e:m-t01-r062-t01-c013,
            e:m-t01-r062-t01-c014 ;
        st:text "If this MRI can’t be performed during the baseline period, it is acceptable to postpone this testing no later than Week 4/ Visit 6." .

    e:u-t01-n-x23-r047 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x23-r047 ;
        st:refersToActivity e:u-t01-r047 ;
        st:refersToCell e:m-t01-r005-t01-c004,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r047-t01-c003,
            e:m-t01-r047-t01-c004,
            e:m-t01-r047-t01-c005,
            e:m-t01-r047-t01-c006,
            e:m-t01-r047-t01-c007,
            e:m-t01-r047-t01-c008,
            e:m-t01-r047-t01-c009,
            e:m-t01-r047-t01-c010,
            e:m-t01-r047-t01-c011,
            e:m-t01-r047-t01-c012,
            e:m-t01-r047-t01-c013,
            e:m-t01-r047-t01-c014,
            e:m-t01-r062-t01-c005,
            e:m-t01-r062-t01-c006,
            e:m-t01-r062-t01-c007,
            e:m-t01-r062-t01-c008,
            e:m-t01-r062-t01-c009,
            e:m-t01-r062-t01-c010,
            e:m-t01-r062-t01-c011,
            e:m-t01-r062-t01-c012,
            e:m-t01-r062-t01-c013,
            e:m-t01-r062-t01-c014 ;
        st:text "Infusion centers are not required to perform this activity on Visit 3; however, the study site is required to perform this review." .

    e:u-t01-n-x23-r062 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x23-r062 ;
        st:refersToActivity e:u-t01-r062 ;
        st:refersToCell e:m-t01-r005-t01-c004,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r047-t01-c003,
            e:m-t01-r047-t01-c004,
            e:m-t01-r047-t01-c005,
            e:m-t01-r047-t01-c006,
