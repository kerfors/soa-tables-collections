            e:m-t01-r062-t01-c012,
            e:m-t01-r062-t01-c013,
            e:m-t01-r062-t01-c014 ;
        st:text "If this X-ray can’t be performed during the baseline period, it is acceptable to postpone this testing no later than Week 4/ Visit 6." .

    e:u-t01-n-x23-r017 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x23-r017 ;
        st:refersToActivity e:u-t01-r017 ;
        st:refersToCell e:m-t01-r005-t01-c004,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r047-t01-c003,
            e:m-t01-r047-t01-c004,
