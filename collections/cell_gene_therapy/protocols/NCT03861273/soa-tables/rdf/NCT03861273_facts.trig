            e:m-t01-r047-t01-c009,
            e:m-t01-r047-t01-c010,
            e:m-t01-r047-t01-c011,
            e:m-t01-r047-t01-c012,
            e:m-t01-r047-t01-c013,
            e:m-t01-r047-t01-c014,
            e:m-t01-r062-t01-c005,
            e:m-t01-r062-t01-c006,
            e:m-t01-r062-t01-c007,
            e:m-t01-r062-t01-c008,
            e:m-t01-r062-t01-c009,
            e:m-t01-r062-t01-c010,
            e:m-t01-r062-t01-c011,
            e:m-t01-r062-t01-c012,
            e:m-t01-r062-t01-c013,
            e:m-t01-r062-t01-c014 ;
        st:text "Plasma, PBMC, saliva, semen, and urine specimens will be collected at baseline and every week after IP administration until 3 consecutive specimens test negative for the given specimen type." .

    e:u-t01-n-x2a-r002 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r002 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Visit 4: The participant is not required to appear in person at this visit. Visit 4 study procedures are not required to be performed if the participant does not appear in person with the exception of all required laboratory specimens (eg, Immunology – Exploratory [IgG vs IgM antibody response], Vector Shedding Analysis by PCR, FIX Activity, Antigen and LFT) which can be obtained via mobile phlebotomy home health services. If participants physically attend this visit, all procedures are to be performed per SOA." .

    e:u-t01-n-x2a-r005 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-x2a-r005-d01,
            e:u-t01-n-x2a-r005-d02 ;
        st:occurrence e:t01-n-x2a-r005 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Review and confirm eligibility criteria (see Sections 5.1 & 5.2). This needs to be completed prior to ordering IP at the beginning of the Baseline Period." .

    e:u-t01-n-x2a-r016 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
