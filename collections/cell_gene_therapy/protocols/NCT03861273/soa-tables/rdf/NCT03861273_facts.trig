            e:m-t01-r062-t01-c012,
            e:m-t01-r062-t01-c013,
            e:m-t01-r062-t01-c014 ;
        st:text "Review and confirm eligibility (see Sections 5.1 & 5.2) prior to infusion (Infusion Center should confirm eligibility with study site)." .

    e:u-t01-n-x23-r016 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x23-r016 ;
        st:refersToActivity e:u-t01-r016 ;
