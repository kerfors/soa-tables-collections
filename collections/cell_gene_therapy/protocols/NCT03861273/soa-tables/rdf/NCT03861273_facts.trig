            e:m-t01-r016-t02-c005,
            e:m-t01-r016-t02-c008,
            e:m-t01-r017-t01-c003,
            e:m-t01-r017-t02-c005,
            e:m-t01-r017-t02-c008,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Some participants (n~20), who consent to participate in an optional sub-study, will undergo joint MRIs (Section 8.1.2.2)." .

    e:u-t01-n-x2a-r018 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r018 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "FibroScan, if performed, would be performed locally." .

    e:u-t01-n-x2a-r020 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r020 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Test to be performed if results are not available in the source documents." .

    e:u-t01-n-x2a-r024 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r024 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Positive inhibitor testing as measured by the central laboratory ≥0.6 Bethesda Units (BU) at Visit 1 would be exclusionary." .

    e:u-t01-n-x2a-r025 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r025 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Participants with Anti-AAV-Spark100 neutralizing antibodies (nAb) titer ≥ 1:1 (ie, positive for nAb) are to be excluded from the study." .

    e:u-t01-n-x2a-r032 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r032 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "FIX Activity and LFT testing will be conducted at local AND central lab for all time points and as clinically necessary (including samples drawn at the clinic and any mobile phlebotomy/ home health service visits). FIX Antigen testing will be conducted ONLY at central lab for all time points and as clinically necessary. Clinical decisions may be based on local and/ or central lab results." .

    e:u-t01-n-x2a-r042 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r042 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Specimen is required at Visit 4 and can be obtained via mobile phlebotomy/ home health service." .

    e:u-t01-n-x2a-r058 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r058 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "PGIC-H is not completed at baseline visit." .

    e:u-t01-n-x2a-r062 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x2a-r062 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r032 ;
        st:refersToCell e:m-t01-r005-t01-c002,
            e:m-t01-r016-t01-c003,
            e:m-t01-r017-t01-c003,
            e:m-t01-r020-t01-c002,
            e:m-t01-r024-t01-c002,
            e:m-t01-r025-t01-c002,
            e:m-t01-r042-t01-c005,
            e:m-t01-r058-t01-c003,
            e:m-t01-r062-t01-c004 ;
        st:refersToColumn e:u-t01-c005 ;
        st:text "Optional Vector Shedding Sub-study: Additional (2 hrs (±30 minutes), 24 hrs (±3 hrs), 72 hrs (±4 hrs) after completion of IP infusion and IV line flush on Day 1) samples (plasma, PBMC, saliva, semen, and urine) will be collected from some participants (n=12) who consent to participate in an optional sub-study. Utilize mobile phlebotomy/ home health services as needed." .

    e:u-t01-r001 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r001,
            e:t02-r001 ;
        st:propertyName "Epoch" ;
        st:propertyType "epoch" .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002,
            e:t02-r002 ;
        st:propertyName "Study Visit" ;
        st:propertyType "visit" .

    e:u-t02-n-g2 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-g2 ;
        st:text "Unscheduled visits may be necessary during the study. Tests being performed are for safety monitoring purposes, for repeat safety assessments, or to repeat any blood sampling if required." .

    e:u-t02-n-g3 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-g3 ;
        st:text "During Long-Term Monitoring Period (Weeks 53 to 312), mobile phlebotomy/ home health services may be utilized as needed, when site visits are not scheduled." .

    e:u-t02-n-g5 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-g5 ;
        st:text "Study Site: Site that will screen and follow participant post-infusion of PF-06838435 for the duration of the study." .

    e:u-t02-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-n1-d01 ;
        st:occurrence e:t02-n-n1 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "Complete Physical Exam at all visits. Vital signs include: body temperature (°C) (see Section 8.2.2), BP, pulse rate, respiratory rate, after at least 5 mins rest in supine or upright/sitting position." .

    e:u-t02-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n11 ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "aPTT (in seconds), INR, TAT, TGA, and D-dimer. These specimens should be collected in the absence of residual infused FIX. The tests may be conducted as clinically indicated throughout the study." .

    e:u-t02-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-n12-d01 ;
        st:occurrence e:t02-n-n12 ;
        st:refersToActivity e:u-t01-r057 ;
        st:text "To be completed by the investigator or the designee (Section 8.1.2.1)." .

    e:u-t02-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-n13-d01 ;
        st:occurrence e:t02-n-n13 ;
        st:refersToActivity e:u-t01-r058 ;
        st:text "Participants will complete 5 instruments at the study site using an electronic tablet: Haem-A-QoL, HAL (v2), PGIC-H, HLIQ, and EQ-5D-5L. The questionnaires should be administered before dosing, treatment, or conversation between health care team and participants about their health condition. See Section 8.1.3 for additional considerations. Every effort should be made to conduct the PROs according to the protocol specified timepoints. If the post-infusion PROs can’t be performed at a particular visit, they should be performed at the next visit." .

    e:u-t02-n-n14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n14 ;
        st:refersToActivity e:u-t02-r026 ;
        st:text "After Week 156, phone calls every 6 months (ie, weeks: 182, 234, 286) in addition to the annual visits. Inquire about AEs and concomitant treatments (including surgeries and procedures)." .

    e:u-t02-n-n15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n15 ;
        st:refersToActivity e:u-t01-r062 ;
        st:text "Semen samples can be collected at home the night before a clinic or mobile phlebotomy/ home health service visit and stored in the participant’s freezer until the clinic or mobile phlebotomy/ home health service visit." .

    e:u-t02-n-n17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-n17-d01 ;
        st:occurrence e:t02-n-n17 ;
        st:refersToActivity e:u-t01-r064 ;
        st:text "During the Long-Term Monitoring Period (Week 53 post-infusion to EOS) the following adverse events will be collected: • SAEs (including medically important events, Appendix 3). • Non-serious AEs determined to be related to IP by the investigator or where causality is unknown." .

    e:u-t02-n-n18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-n18-d01 ;
        st:occurrence e:t02-n-n18 ;
        st:refersToActivity e:u-t01-r068 ;
        st:text "During the Long-Term Monitoring Period (Week 53 post-infusion to EOS) the concomitant therapy associated with: SAEs (including medically important events, Appendix 3) Non-serious AEs determined to be related to IP by the investigator or where causality is unknown. All procedures and surgeries (including elective surgeries) during the Long-Term Monitoring Period are to be recorded." .

    e:u-t02-n-n19 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n19 ;
        st:refersToActivity e:u-t01-r047 ;
        st:text "Review the eDiary; ensure appropriate entries, during unscheduled and scheduled visits." .

    e:u-t02-n-n20 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n20 ;
        st:refersToActivity e:u-t02-r032 ;
        st:refersToCell e:m-t02-r032-t02-c008 ;
        st:text "The eDiary will be returned during the Week 312 visit." .

    e:u-t02-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n4 ;
        st:refersToActivity e:u-t01-r024 ;
        st:text "Nijmegen Bethesda Inhibitor Assay: At central laboratory; local laboratory allowed if required for clinical reasons. These specimens should be collected in the absence of residual infused FIX." .

    e:u-t02-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n5 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text "Whole blood will be collected for determination of anti-PF-06838435 antibodies (ADA) from human serum." .

    e:u-t02-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n6 ;
        st:refersToActivity e:u-t01-r027 ;
        st:text "• Hematology: WBC and differential, RBC, hemoglobin, hematocrit, and platelet count • Chemistry: Na, K, Cl, phosphate, bicarbonate, glucose, BUN, serum creatinine." .

    e:u-t02-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n7 ;
        st:refersToActivity e:u-t01-r032 ;
        st:text "• LFT: albumin, total bilirubin, direct bilirubin, indirect bilirubin (if available), ALP, AST, ALT, total protein, GGT, LDH. • FIX:C, FIX Ag. • FIX Activity should be collected in the absence of residual infused FIX • Sponsor recommends collecting specimens on Mondays through Thursdays so that the results are available prior to the weekend. • Utilize mobile phlebotomy/ home health services as needed." .

    e:u-t02-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n8 ;
        st:refersToActivity e:u-t01-r037 ;
        st:text "• Specimens for PBMC by ELISPOT are to be collected at End of Study and if the corticosteroid treatment is needed for a suspected T-cell response. • Specimens are to be collected prior to initiating the corticosteroid treatment. If not collected prior to initiation, specimens must be collected within 24 hours of administering corticosteroids. • It is highly recommended that participants who are initiated on corticosteroid treatment be treated with a gastric acid reducer, preferably a proton pump inhibitor (PPI) (eg, omeprazole), or alternatively a histamine type 2 (H2) antagonist (eg, ranitidine) for the duration of the corticosteroid course. • Specimens are to be collected approximately 3 weeks after steroid administration. Additional specimens may be necessary if ELISPOT has not normalized at 3 weeks and/or based on medical judgement." .

    e:u-t02-n-x23-r006 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-x23-r006 ;
        st:refersToActivity e:u-t01-r016 ;
        st:refersToCell e:m-t01-r016-t02-c005,
            e:m-t01-r016-t02-c008,
            e:m-t01-r017-t02-c005,
            e:m-t01-r017-t02-c008,
            e:m-t01-r032-t02-c006,
            e:m-t01-r032-t02-c007,
            e:m-t01-r062-t02-c002,
            e:m-t01-r062-t02-c003,
            e:m-t01-r062-t02-c004,
            e:m-t01-r062-t02-c005,
            e:m-t01-r062-t02-c006,
            e:m-t01-r062-t02-c007,
            e:m-t01-r062-t02-c008 ;
        st:text "If the baseline X-ray could not be performed ≤ Week 4/ Visit 6, the study participant does not need to do the 3 (Visit 17) and 6 year (Visit 20) follow-up X-rays." .

    e:u-t02-n-x23-r007 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-x23-r007 ;
        st:refersToActivity e:u-t01-r017 ;
        st:refersToCell e:m-t01-r016-t02-c005,
            e:m-t01-r016-t02-c008,
            e:m-t01-r017-t02-c005,
            e:m-t01-r017-t02-c008,
            e:m-t01-r032-t02-c006,
            e:m-t01-r032-t02-c007,
            e:m-t01-r062-t02-c002,
            e:m-t01-r062-t02-c003,
            e:m-t01-r062-t02-c004,
            e:m-t01-r062-t02-c005,
            e:m-t01-r062-t02-c006,
            e:m-t01-r062-t02-c007,
            e:m-t01-r062-t02-c008 ;
        st:text "If the baseline MRI could not be performed ≤ Week 4/ Visit 6, the study participant does not need to do the 3 (Visit 17) and 6 (Visit 20) year follow-up MRIs." .

    e:u-t02-n-x23-r016 a st:UnifiedAnnotation ;
