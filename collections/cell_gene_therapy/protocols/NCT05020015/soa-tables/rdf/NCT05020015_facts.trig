    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c002 ;
        st:text "The screening visit must occur within 28 days before the day of LDC. Signed informed consent must be obtained before performing any protocol-specific procedure." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToActivity e:u-t01-r026 ;
        st:refersToCell e:m-t01-r026-t01-c004 ;
        st:refersToColumn e:u-t01-c004 ;
        st:text "All assessments must be completed and evaluated before dosing." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToActivity e:u-t01-r008,
            e:u-t01-r009,
            e:u-t01-r011,
            e:u-t01-r013,
            e:u-t01-r014,
            e:u-t01-r015,
            e:u-t01-r029 ;
        st:refersToCell e:m-t01-r008-t01-c012,
            e:m-t01-r008-t01-c013,
            e:m-t01-r008-t01-c014,
            e:m-t01-r008-t01-c015,
            e:m-t01-r009-t01-c015,
            e:m-t01-r011-t01-c012,
            e:m-t01-r013-t01-c012,
            e:m-t01-r013-t01-c014,
            e:m-t01-r014-t01-c012,
            e:m-t01-r014-t01-c014,
            e:m-t01-r015-t01-c012,
            e:m-t01-r015-t01-c013,
            e:m-t01-r015-t01-c014,
            e:m-t01-r015-t01-c015,
            e:m-t01-r029-t01-c013,
            e:m-t01-r029-t01-c015 ;
        st:text "Not required for a patient with documented disease progression and/or begins a new systemic, anticancer therapy at the prior visit." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-d ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "For women of childbearing potential, a serum pregnancy test will be performed at screening. A urine pregnancy test will be allowed for all other visits. A negative pregnancy test result on Day -5 is necessary before initiation of LDC. If menstrual period is delayed during the study, absence of pregnancy must be confirmed by serum pregnancy test." .

    e:u-t01-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-e ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "Height to be measured at screening only." .

    e:u-t01-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-f ;
        st:refersToActivity e:u-t01-r014 ;
        st:refersToCell e:m-t01-r014-t01-c004 ;
        st:text "Vital signs and SpO2: Before TAK-007 administration and until the patient is clinically stable, at a minimum, 15, 30, 45, 60 minutes (±5 minutes) and 1.5, 2, and 3 hours (±10 minutes) after start of TAK-007 administration." .

    e:u-t01-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g ;
        st:refersToActivity e:u-t01-r015 ;
        st:text "Coagulation will only be assessed at screening and as clinically indicated. Immunoglobulins will not be assessed between Day 0 and Day 21." .

    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g1 ;
        st:text "Tests and procedures should be performed on schedule for all visits. Evaluations and procedures identified in the schedule of events may be performed at unscheduled visits, as clinically indicated, at the investigator’s discretion in consultation with the sponsor. If a patient is not able to visit the study site, then a telehealth visit should be considered to ensure appropriate oversight and safety monitoring. In addition to this, if the patient is able to visit a local doctor and/or laboratory, then appropriate assessments may be performed at a local laboratory or doctor’s office, per investigator discretion." .

    e:u-t01-n-g2 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g2 ;
        st:text "Day 0 will be defined as the actual day of first TAK-007 administration, hence the reference of all subsequent dates." .

    e:u-t01-n-g3 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g3,
            e:t02-n-g2 ;
        st:text "After the Day 28 visit, each month will count as 30 days." .

    e:u-t01-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-h ;
        st:refersToActivity e:u-t01-r015 ;
        st:refersToCell e:m-t01-r015-t01-c004 ;
        st:text "Hematology samples will be collected before TAK-007 administration and 1 hour (±15 minutes) after start of TAK-007 administration." .

    e:u-t01-n-i a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-i-d01 ;
        st:occurrence e:t01-n-i ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "Details on monitoring of AEs and period of observation during the primary follow-up phase are summarized in Section 10.3." .

    e:u-t01-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-j ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "Survival will be followed up for patients who receive TAK-007 administration. Survival will be followed-up every 3 months. If a patient misses a scheduled visit, or if the time-point does not align with a scheduled visit, survival status may be collected by methods that include, but are not limited to, telephone, email, mail, or retrieval from online or other databases (eg, Social Security indexes)." .

    e:u-t01-n-k a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-k ;
        st:refersToActivity e:u-t01-r028 ;
        st:text "A lymphoma biopsy at screening is mandatory unless archived tumor lymphoma tissue (at least 10 unstained FFPE slides) collected after the last therapy is available. Sponsor waiver may be given on a case by case basis. For all patients, Days 7 to 14 biopsies will be optional. Biopsies at relapse are recommended. There should be no clinical contraindication and lymphoma should be easily accessible." .

    e:u-t01-n-l a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-l ;
        st:refersToActivity e:u-t01-r029 ;
        st:text "Disease assessment per IWG 2014 guidelines will be performed until PD by imaging, or additional lymphoma therapy except consolidating autologous or allogeneic stem cell transplantation. Assessments will be performed per local guidance." .

    e:u-t01-n-m a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-m ;
        st:refersToActivity e:u-t01-r030 ;
        st:text "Baseline BM evaluation is required for all patients at screening except for patients with LBCL with confirmed BM involvement in PET-CT. Archived BM biopsy sample (and assessment) within 42 days before start of lymphodepleting chemotherapy is acceptable if no antitumor therapy was given after BM evaluation. After baseline evaluation, BM will be evaluated in patients with iNHL who had initial BM involvement and in whom, treatment achieved CR in imaging. There should be no clinical contraindication for BM evaluation." .

    e:u-t01-n-n a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n ;
        st:refersToActivity e:u-t01-r031 ;
        st:text "Optional BM aspiration for pharmacokinetics will be performed between Days 7 and 14. Based on the emerging data, collection from additional patients may be waived or made optional. BM aspirate is also recommended at relapse. There should be no clinical contraindication for BM evaluation." .

    e:u-t01-r001 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r001,
            e:t02-r001,
            e:t03-r001 ;
        st:propertyName "Phase" ;
        st:propertyType "epoch" .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002,
            e:t02-r002,
            e:t03-r002 ;
        st:propertyName "Days" ;
        st:propertyType "study_day" .

    e:u-t01-r003 a st:UnifiedProperty ;
        st:member e:t01-r003,
            e:t02-r004 ;
        st:propertyName "Visit window" ;
        st:propertyType "window" .

    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToColumn e:u-t02-c011 ;
        st:text "For patients who have documented progression at a prior visit and/or begin a new systemic anticancer treatment at a prior visit, only M3 and M6 samples are required where indicated." .

    e:u-t02-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-b ;
        st:refersToActivity e:u-t02-r005,
            e:u-t02-r006 ;
        st:refersToCell e:m-t02-r005-t02-c003,
            e:m-t02-r006-t02-c003 ;
        st:text "Samples will be collected before and after (1 hour ±15 minutes) TAK-007 administration." .

    e:u-t02-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c ;
        st:refersToActivity e:u-t02-r006,
            e:u-t02-r009,
            e:u-t02-r010,
            e:u-t02-r011,
            e:u-t02-r012,
            e:u-t02-r013,
            e:u-t02-r014 ;
        st:refersToCell e:m-t02-r006-t02-c011,
            e:m-t02-r009-t02-c011,
            e:m-t02-r010-t02-c011,
            e:m-t02-r011-t02-c011,
            e:m-t02-r012-t02-c011,
            e:m-t02-r013-t02-c011,
            e:m-t02-r014-t02-c011 ;
        st:text "Sample is not required if patient has documented progression and/or begin a new systemic anticancer treatment at a prior visit." .

    e:u-t02-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-d ;
        st:refersToActivity e:u-t02-r011 ;
        st:text "Additional samples may be collected during safety assessment if patient develops Grade 3 toxicity." .

    e:u-t02-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-g1 ;
        st:text "Unless otherwise noted, evaluations during the conditioning and treatment phases must occur before LDC administration or TAK-007 administration. Tests and procedures should be performed on schedule for all visits. If extenuating circumstances prevent a patient from completing a scheduled procedure or assessment within this time, the patient may continue the study only with the written permission of the medical monitor." .

    e:u-t02-r003 a st:UnifiedProperty ;
        st:level 3 ;
        st:member e:t02-r003 ;
        st:propertyName "Study Day" ;
        st:propertyType "study_day" .

    e:u-t03-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t03-n-a-d01 ;
        st:occurrence e:t03-n-a ;
        st:refersToActivity e:u-t03-r004 ;
        st:text "During secondary follow-up, all AEs with onset date more than 6 months until 24 months after TAK-007 administration should be reported according to criteria listed in Section 10.3." .

    e:u-t03-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t03-n-b-d01 ;
        st:occurrence e:t03-n-b ;
        st:refersToActivity e:u-t03-r004 ;
        st:text "During LTFU, all related SAEs, all deaths, and new incidences of Grade ≥3 AEs that are at least possibly related to TAK-007 and/or lymphodepletion and relevant to the potential risks of TAK-007 will be collected (see Section 10.3)." .

    e:u-t03-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-c ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "Survival follow-up should be conducted every 6 months in secondary and at least annually during the long-term follow-up phases. If a patient misses a scheduled visit, or if the time-point does not align with a scheduled visit, survival status may be collected by methods that include, but are not limited to, medical records review, telephone, email, mail, or retrieval from online or other databases (eg, Social Security indexes)." .

    e:u-t03-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-d ;
        st:refersToActivity e:u-t03-r007 ;
        st:refersToCell e:m-t03-r007-t03-c003 ;
        st:text "New anticancer therapy need not be collected if samples for CK (DNA) are no longer being taken after Month 24." .

    e:u-t03-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-e ;
        st:refersToActivity e:u-t02-r005 ;
        st:text "If CAR transgene is detectable at Months 24, 36, or 48, additional samples will be collected within the next 6 months ie, at Months 30, 42, and 54, respectively, for further clonality assessment." .

    e:u-t03-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-f ;
        st:refersToActivity e:u-t02-r008 ;
        st:refersToCell e:m-t02-r008-t03-c002,
            e:m-t02-r008-t03-c003 ;
        st:text "If all post-treatment assays for an individual patient are negative during the first year, collection of the yearly follow-up samples may be discontinued for that individual." .

    e:u-t03-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-g1 ;
        st:text "Tests and procedures should be performed within the specified windows for all visits. If extenuating circumstances prevent a patient from completing a scheduled procedure or assessment within this time, the patient may continue the study only with the written permission of the medical monitor. If a patient is not able to visit the study site, then a telehealth visit should be considered to ensure appropriate oversight and safety monitoring. In addition to this, if the patient is able to visit a local doctor and/or laboratory, then appropriate assessments may be performed at a local laboratory or doctor’s office, per investigator discretion." .

    e:u-t03-n-g2 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-g2 ;
        st:text "Each month will count as 30 days." .

    e:u-t03-r003 a st:UnifiedProperty ;
        st:member e:t03-r003 ;
        st:propertyName "Window" ;
        st:propertyType "window" .

