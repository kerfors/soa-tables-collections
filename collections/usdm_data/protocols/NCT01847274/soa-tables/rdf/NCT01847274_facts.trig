    e:u-t01-n-1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-1,
            e:t02-n-1 ;
        st:refersToColumn e:u-t02-c005,
            e:u-t02-c006,
            e:u-t02-c007 ;
        st:refersToProperty e:u-t01-r001 ;
        st:text "Treatment cycles are 28 days long, visits on Day 1 of each cycle unless otherwise specified." .

    e:u-t01-n-10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-10,
            e:t02-n-14 ;
        st:refersToActivity e:u-t01-r014 ;
        st:refersToCell e:m-t01-r014-t01-c009,
            e:m-t01-r014-t02-c009 ;
        st:text "SAEs recorded up to 30 days after study treatment discontinuation." .

    e:u-t01-n-11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-11 ;
        st:refersToActivity e:u-t01-r016 ;
        st:refersToCell e:m-t01-r016-t01-c003 ;
        st:text "If Screening laboratory testing (serum chemistry, CBC, coagulation) performed within 72 hours of Day 1, repeat testing not required." .

    e:u-t01-n-12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-12 ;
        st:refersToActivity e:u-t01-r017 ;
        st:text "If dose interruption or modification is required at any point on study because of hematologic toxicity, weekly blood draws for CBC will be monitored until the adverse event resolves, and to ensure safety of the new dose, weekly blood draws for CBC will be also be required for an additional 4 weeks after the adverse event has been resolved to the specified levels, after which monitoring every 4 weeks may resume." .

    e:u-t01-n-13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-13 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "CA-125 levels must be normal at screening or > 90% decrease as compared with baseline prior to last platinum-based chemotherapy course. Abnormal CA-125 levels during study do not represent disease progression; however, they may prompt imaging if clinically indicated. CA-125 sample within 72 hours of dose on Cycle 1/Day 1." .

    e:u-t01-n-14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-14-d01 ;
        st:occurrence e:t01-n-14 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "For determination of CA-125 progression, at least 2 CA-125 values at least 1 week apart are required for confirmation (Section 6.1)." .

    e:u-t01-n-15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-15 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "Urinalysis parameters must include: specific gravity, leukocyte esterase, nitrite, blood, protein, glucose, ketones, urobilinogen, and bilirubin." .

    e:u-t01-n-16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-16 ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "Patients will have a 12-lead ECG at Screening, Baseline (predose, within 30 minutes), 2 hours postdose on Day 1(within 30 minutes), Cycle 2/Day 1, (predose, 2 hours postdose, within 30 minutes) and upon study treatment discontinuation. Note that the ECG is to be completed prior to the PK blood draw." .

    e:u-t01-n-17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-17 ;
        st:refersToActivity e:u-t01-r021 ;
        st:refersToCell e:m-t01-r021-t01-c003 ;
        st:text "At selected sites, a subset of patients (approximately 24) will undergo triplicate ECG testing on Day 1 only at baseline (predose) and 1, 1.5, 2, 3, 4, 6 and 8 hours postdose. Triplicate ECGs should be performed between 2-5 minutes apart and should be performed prior to blood draws for PK." .

    e:u-t01-n-18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-18 ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "Formalin fixed, paraffin-embedded tumor sample (primary or metastatic site) consisting of 100 micron thickness of sections (≥ 80 micron minimum) or unsectioned paraffin block." .

    e:u-t01-n-19 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-19 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c003 ;
        st:text "Blood samples for PK collected on Cycle 1/Day 1 and Cycle 2/Day 1 collected predose (within 30 minutes) and 2 hours postdose (within 30± 15 minutes Note: The exact time of the PK blood draw will be recorded and ECG monitoring is to be completed prior to the PK blood draw." .

    e:u-t01-n-2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-2,
            e:t02-n-2 ;
        st:refersToColumn e:u-t01-c008,
            e:u-t02-c008 ;
        st:text "Visits continue every 4 weeks until study treatment discontinuation." .

    e:u-t01-n-20 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-20 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c003 ;
        st:text "At selected sites, a subset of patients (approximately 12) undergoing intensive PK on Day1 will have samples collected at baseline (within 30 minutes predose) and 1, 1.5, 2, 3, 4, 6 and 8 hours (± 2 minutes at all time points) postdose. Note: The exact time of the PK blood draw will be recorded and the ECG monitoring is to be completed prior to the PK blood draw." .

    e:u-t01-n-21 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-21 ;
        st:refersToActivity e:u-t01-r023 ;
        st:refersToCell e:m-t01-r023-t01-c008 ;
        st:text "Additional blood samples for PK on Cycle 4/Day 1 and Cycle 8/Day 1 will be collected at predose (trough) within 30 minutes only." .

    e:u-t01-n-22 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-22 ;
        st:refersToActivity e:u-t01-r024 ;
        st:text "RECIST tumor assessment via CT or MRI scan of abdomen/pelvis and clinically indicated areas required at baseline, then after every 2 cycles (ie, 8 weeks with a window of ± 7 days from date of visit) through Cycle 14 (56 weeks), then after every 6 cycles (24 weeks with a window of ± 7 days) until study treatment discontinuation; at this point, a final follow-up set of imaging is required. PET/CT may be used according to RECIST guidelines. Cycle timing will not be delayed for treatment interruptions, and tumor assessment should occur according to this schedule regardless of whether study treatment is interrupted. If a patient discontinues treatment for clinical progression and does not meet the criteria specified in the protocol, scans and CA-125 testing should continue at the specified intervals until progression is confirmed or until the start of subsequent anticancer treatment." .

    e:u-t01-n-23 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-23 ;
        st:refersToActivity e:u-t01-r025 ;
        st:text "Chest CT/MRI if not done as part of RECIST tumor assessment at Screening. If the chest CT/MRI is clear at screening, repeat chest imaging is not required in the absence of lesions to be followed or in the absence of clinical indication requiring follow‐up." .

    e:u-t01-n-24 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-24 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text "PROs (FOSI, EQ-5D-5L, neuropathy questionnaire) will be collected while on study treatment every 8 weeks through the first year, then every 12 weeks thereafter. If the patient discontinues study treatment, assessment will occur at that time and then 8 weeks (± 2 weeks) later, regardless of status of subsequent treatment. PROs should be administered before conducting any other procedures." .

    e:u-t01-n-25 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-25 ;
        st:refersToActivity e:u-t01-r027 ;
        st:refersToCell e:m-t01-r027-t01-c009 ;
        st:text "No new capsules dispensed" .

    e:u-t01-n-26 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-26 ;
        st:refersToActivity e:u-t01-r028 ;
        st:refersToCell e:m-t01-r028-t01-c010 ;
        st:text "Every 90 days following study treatment discontinuation." .

    e:u-t01-n-27 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-27 ;
        st:refersToActivity e:u-t01-r029 ;
        st:text "In addition to survival, this assessment includes outcomes for subsequent anticancer therapies including any new malignancy information." .

    e:u-t01-n-28 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-28,
            e:t02-n-15 ;
        st:refersToActivity e:u-t01-r030 ;
        st:refersToCell e:m-t01-r030-t01-c003,
            e:m-t01-r030-t01-c004,
            e:m-t01-r030-t01-c005,
            e:m-t01-r030-t01-c006,
            e:m-t01-r030-t01-c007,
            e:m-t01-r030-t01-c008,
            e:m-t01-r030-t01-c009,
            e:m-t01-r030-t01-c010,
            e:m-t01-r030-t02-c003,
            e:m-t01-r030-t02-c004,
            e:m-t01-r030-t02-c005,
            e:m-t01-r030-t02-c006,
            e:m-t01-r030-t02-c007,
            e:m-t01-r030-t02-c008,
            e:m-t01-r030-t02-c009 ;
        st:text "For any suspected MDS/AML case reported while a patient is receiving treatment or being followed for post-treatment assessments, bone marrow aspirate and biopsy testing must be completed by a local hematologist. Testing completed as part of standard of care is sufficient as long as the methods are acceptable to the Sponsor’s Medical Monitor. The study site must receive a copy of the hematologist's report of aspirate/biopsy findings (which must include a classification according to WHO criteria²⁰) and other sample testing results related to MDS/AML." .

    e:u-t01-n-3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-3 ;
        st:refersToColumn e:u-t01-c003 ;
        st:text "C1/D1 is day of first dose." .

    e:u-t01-n-4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-4 ;
        st:refersToActivity e:u-t01-r003 ;
        st:text "A separate ICF may be signed prior to the screening period for Myriad Integrated BRACAnalysis® testing in order to facilitate early testing. Depending on local site requirements, patients may sign a single study ICF prior to the screening period to facilitate early gBRCAmut testing only. All other study tests and procedures must be done in the screening window (Day -28 to Day -1)." .

    e:u-t01-n-5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-5 ;
        st:refersToActivity e:u-t01-r006 ;
        st:text "Local gBRCAmut results that had been performed previously should be entered into eCRF at screening." .

    e:u-t01-n-6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-6 ;
        st:refersToActivity e:u-t01-r007 ;
        st:refersToCell e:m-t01-r007-t01-c002 ;
        st:text "Centralized gBRCAmut testing of DNA by Integrated BRACAnalysis® at Myriad must be completed prior to randomization. The sample may be submitted prior to the screening period for patients who are identified for a Screening Visit to occur. DNA from this sample will be stored and may be used at a later time for biomarker testing including potential to bridging to candidate companion diagnostic assays." .

    e:u-t01-n-7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-7 ;
        st:refersToActivity e:u-t01-r009 ;
        st:refersToCell e:m-t01-r009-t01-c002,
            e:m-t01-r009-t01-c008 ;
        st:text "Negative serum pregnancy test required within 72 hours from first dose of study treatment for females of childbearing potential; repeated every 3 months for duration of study (ie, Cycle 4, Cycle 7, etc)." .

    e:u-t01-n-8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-8 ;
        st:refersToActivity e:u-t01-r010 ;
        st:refersToCell e:m-t01-r010-t01-c002 ;
        st:text "Randomization must occur within 72 hours prior to first dose." .

    e:u-t01-n-9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-9,
            e:t02-n-7 ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "Height obtained at screening only." .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002,
            e:t02-r002,
            e:t03-r002 ;
        st:propertyName "Day" ;
        st:propertyType "study_day" .

    e:u-t02-n-10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-10 ;
        st:refersToActivity e:u-t01-r020 ;
        st:refersToCell e:m-t01-r020-t02-c003,
            e:m-t01-r020-t02-c004 ;
        st:text "Triplicate ECG monitoring to coincide with PK on FE Days 1 and 8 at baseline (predose) and at 1, 1.5, 2, 3, 4, 6, and 8 hours post-dose. Triplicate ECGs should be performed between 2-5 minutes apart and should be performed prior to blood draws for PK." .

    e:u-t02-n-11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-11 ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "Blood samples for PK will be taken on FE Days 1 and 8 at baseline (within 30 minutes prior to dosing) and at 1, 1.5, 2, 3, 4, 6, 8, 12, 24, 48, 72, 96, and 120 hours postdose. Additional blood samples will be collected predose and 2 hours postdose on Day 1 of Cycles 1 and 2 and predose only on Day 1 of Cycles 4 and 8. The exact time of the PK blood draw will be recorded and PK blood draws are to be completed after ECG monitoring." .

    e:u-t02-n-3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-3 ;
        st:refersToActivity e:u-t01-r009 ;
        st:refersToCell e:m-t01-r009-t02-c002,
            e:m-t01-r009-t02-c005 ;
        st:text "Negative serum pregnancy test required within 72 hours prior to study treatment for females of childbearing potential; repeated every 3 months for duration of study (ie, Cycle 4, Cycle 7, etc)." .

    e:u-t02-n-4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-4 ;
        st:refersToActivity e:u-t01-r010 ;
        st:refersToCell e:m-t01-r010-t02-c002 ;
        st:text "Patients will be randomized in a crossover design within 72 hours prior to FE Day 1 (first single dose)." .

    e:u-t02-n-5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-5 ;
        st:refersToActivity e:u-t01-r027 ;
        st:refersToCell e:m-t01-r027-t02-c003,
            e:m-t01-r027-t02-c004 ;
        st:text "Patients receive a single oral dose of niraparib 300 mg on FE Days 1 and 8." .

    e:u-t02-n-6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-6 ;
        st:refersToActivity e:u-t01-r027 ;
        st:refersToCell e:m-t01-r027-t02-c009 ;
        st:text "No new capsules dispensed." .

    e:u-t02-n-8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-8 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "Urinalysis parameters must include: specific gravity, leukocyte esterase, nitrite, blood, protein, glucose, ketones, urobilinogen and bilirubin." .

    e:u-t02-n-9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-9 ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "12-lead ECG at Screening, Cycle 1/Day 1 (predose and 2 hours postdose), Cycle 2/Day 1 (predose and 2 hours postdose), and at treatment discontinuation. ECG monitoring is to be performed prior to PK blood draws." .

    e:u-t02-n-n1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n1 ;
        st:text "Note: Patients in food effect sub-study will receive a single oral dose of niraparib 300 mg on FE Days 1 and 8. Upon completion of the 14-day sub-study, patients will then start open-label treatment with daily niraparib (300 mg QD) on Day 1/Cycle 1 (approximately 2 weeks after start of food effect sub-study) and will be followed using the main study visit schedule for safety." .

    e:u-t02-r003 a st:UnifiedProperty ;
        st:level 3 ;
        st:member e:t02-r003,
            e:t03-r003 ;
        st:propertyName "Day" ;
        st:propertyType "study_day" .

    e:u-t03-n-1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-1 ;
        st:refersToColumn e:u-t03-c002 ;
        st:text "During the in-clinic visit extended cycle, all study procedures and assessments required will be performed." .

    e:u-t03-n-10 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-10 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r024 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, so this most likely corresponds to Table 7 (Main Study) footnote 22: \"RECIST tumor assessment via CT or MRI scan of abdomen/pelvis and clinically indicated areas required at baseline, then after every 2 cycles (ie, 8 weeks with a window of ± 7 days from date of visit) through Cycle 14 (56 weeks), then after every 6 cycles (24 weeks with a window of ± 7 days) until study treatment discontinuation; at this point, a final follow-up set of imaging is required. PET/CT may be used according to RECIST guidelines. Cycle timing will not be delayed for treatment interruptions, and tumor assessment should occur according to this schedule regardless of whether study treatment is interrupted. If a patient discontinues treatment for clinical progression and does not meet the criteria specified in the protocol, scans and CA-125 testing should continue at the specified intervals until progression is confirmed or until the start of subsequent anticancer treatment.\" NOTE (clinical review 2026-08-15): §7.4.2 states RECIST \"after every 2 cycles through Cycle 14 and then after every 3 cycles\", which conflicts with footnote 22's post-Cycle-14 cadence of every 6 cycles (24 weeks) — a source-internal contradiction, left unresolved; hypothesis retained." ;
        st:text "" .

    e:u-t03-n-11 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-11 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r026 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, this corresponds to Table 7 (Main Study) footnote 24: \"PROs (FOSI, EQ-5D-5L, neuropathy questionnaire) will be collected while on study treatment every 8 weeks through the first year, then every 12 weeks thereafter. If the patient discontinues study treatment, assessment will occur at that time and then 8 weeks (± 2 weeks) later, regardless of status of subsequent treatment. PROs should be administered before conducting any other procedures.\" Mapping confirmed by clinical review (2026-08-15): §7.4.2 states PROs every 3 cycles (= every 12 weeks, matching footnote 24) and repeats \"PROs should be administered before conducting any other procedures\" verbatim; §7.4.4 matches the 8 (± 2) weeks post-discontinuation assessment." ;
        st:text "" .

    e:u-t03-n-12 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-12 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r027 ;
        st:refersToCell e:m-t01-r027-t03-c005 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, this corresponds to Table 7 (Main Study) footnote 25: \"No new capsules dispensed\" Mapping confirmed by clinical review (2026-08-15): §7.4.3 lists \"Study treatment capsules collected\" (no dispensing) at discontinuation." ;
        st:text "" .

    e:u-t03-n-13 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-13 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t03-r016 ;
        st:refersToCell e:m-t03-r016-t03-c006 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, this corresponds to Table 7 (Main Study) footnote 26: \"Every 90 days following study treatment discontinuation.\" Mapping confirmed by clinical review (2026-08-15): §7.4.4: \"Assessment of next subsequent anticancer therapies will be assessed every 90 days (± 28 days) following study treatment discontinuation visit.\"" ;
        st:text "" .

    e:u-t03-n-14 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-14 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r029 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, this corresponds to Table 7 (Main Study) footnote 27: \"In addition to survival, this assessment includes outcomes for subsequent anticancer therapies including any new malignancy information.\" Mapping confirmed by clinical review (2026-08-15): §7.4.4: survival status every 90 days (± 28 days) post-discontinuation; \"New malignancy information will also be collected as part of this assessment.\"" ;
        st:text "" .

    e:u-t03-n-15 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-15 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r030 ;
        st:refersToCell e:m-t01-r030-t03-c002,
            e:m-t01-r030-t03-c003,
            e:m-t01-r030-t03-c004,
            e:m-t01-r030-t03-c005,
            e:m-t01-r030-t03-c006 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, this corresponds to Table 7 (Main Study) footnote 28: \"For any suspected MDS/AML case reported while a patient is receiving treatment or being followed for post-treatment assessments, bone marrow aspirate and biopsy testing must be completed by a local hematologist. Testing completed as part of standard of care is sufficient as long as the methods are acceptable to the Sponsor’s Medical Monitor. The study site must receive a copy of the hematologist's report of aspirate/biopsy findings (which must include a classification according to WHO criteria) and other sample testing results related to MDS/AML.\" Mapping confirmed by clinical review (2026-08-15): §7.4.5 (Unscheduled Assessments) reproduces this text verbatim." ;
        st:text "" .

    e:u-t03-n-2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-2 ;
        st:refersToColumn e:u-t03-c003 ;
        st:text "The study coordinator will contact the patient by telephone to obtain information for the ECOG performance status, adverse event monitoring, and concomitant medications when the study assessments are not performed in clinic." .

    e:u-t03-n-3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-3 ;
        st:refersToColumn e:u-t03-c004 ;
        st:text "The collection of blood samples for CBC and chemistry analysis, vital signs and weight may be collected during visit to local clinic or at in-home nursing visit when the study assessments are not performed in clinic." .

    e:u-t03-n-4 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-4 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r012 ;
        st:refersToCell e:m-t01-r012-t03-c004 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3); no confident Table 7 (Main Study) equivalent for this Vital signs cell in the 'Patient Visit to Local Clinic or In-Home Nursing' column. Clinical review 2026-08-15: remains unresolved — no Table 7 candidate (Table 7's vital-signs footnote is \"Height obtained at screening only\"); §7.4.1 confirms vital signs at the local clinic/in-home nursing visit, content already covered by printed footnote 3." ;
        st:text "" .

    e:u-t03-n-5 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-5 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r014 ;
        st:refersToCell e:m-t01-r014-t03-c005 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, this corresponds to Table 7 (Main Study) footnote 10: \"SAEs recorded up to 30 days after study treatment discontinuation.\" Mapping confirmed by clinical review (2026-08-15): §7.4.3 lists \"AEs (SAEs recorded 30 days post study treatment discontinuation)\"." ;
        st:text "" .

    e:u-t03-n-6 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-6 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r017 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, so this most likely corresponds to Table 7 (Main Study) footnote 12: \"If dose interruption or modification is required at any point on study because of hematologic toxicity, weekly blood draws for CBC will be monitored until the adverse event resolves, and to ensure safety of the new dose, weekly blood draws for CBC will be also be required for an additional 4 weeks after the adverse event has been resolved to the specified levels, after which monitoring every 4 weeks may resume.\" Clinical review 2026-08-15: hypothesis retained; §7.4 does not restate this rule." ;
        st:text "" .

    e:u-t03-n-7 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-7 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r018 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, so this most likely corresponds to Table 7 (Main Study) footnote 13: \"CA-125 levels must be normal at screening or > 90% decrease as compared with baseline prior to last platinum-based chemotherapy course. Abnormal CA-125 levels during study do not represent disease progression; however, they may prompt imaging if clinically indicated. CA-125 sample within 72 hours of dose on Cycle 1/Day 1.\" Clinical review 2026-08-15: hypothesis retained; note the screening and Cycle 1/Day 1 clauses of footnote 13 are phase-specific and may not apply in extended cycles; §7.4 is silent on CA-125 rules." ;
        st:text "" .

    e:u-t03-n-8 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-8 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r018 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, so this most likely corresponds to Table 7 (Main Study) footnote 14: \"For determination of CA-125 progression, at least 2 CA-125 values at least 1 week apart are required for confirmation (Section 6.1).\" Clinical review 2026-08-15: hypothesis retained; content is phase-independent; §7.4 does not restate it." ;
        st:text "" .

    e:u-t03-n-9 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-9 ;
        st:placeholderReason "not_printed" ;
        st:refersToActivity e:u-t01-r020 ;
        st:reviewNote "Footnote not printed in the source (Table 9 prints only footnotes 1-3). Table 9 is the Extended-Visit-Cycle variant of the Main Study, this corresponds to Table 7 (Main Study) footnote 16: \"Patients will have a 12-lead ECG at Screening, Baseline (predose, within 30 minutes), 2 hours postdose on Day 1(within 30 minutes), Cycle 2/Day 1, (predose, 2 hours postdose, within 30 minutes) and upon study treatment discontinuation. Note that the ECG is to be completed prior to the PK blood draw.\" Mapping confirmed by clinical review (2026-08-15): §7.4.3 lists 12-lead ECG at study treatment discontinuation — the only ECG mark in this table; the screening/PK clauses of footnote 16 do not apply in extended cycles." ;
        st:text "" .

    e:decision-ccorr-003 a st:Decision ;
        st:decidedAt "2026-10-04T08:20:00Z"^^xsd:dateTime ;
        st:decidedByPerson "Kerstin Forsberg" ;
        st:decisionSource e:t02-r014 ;
        st:decisionTarget e:t01-r016 ;
        st:op "keep" ;
        st:reason "Different tests: hematology, not coagulation." .

    e:m-t01-r007-t01-c002 a st:ConsolidatedCell ;
        prov:wasDerivedFrom e:t01-r007-c002 ;
