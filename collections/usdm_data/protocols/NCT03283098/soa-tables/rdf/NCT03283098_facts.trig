    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c018 ;
        st:text "If a treated subject withdraws before completion of dosing, the investigator will make every effort to perform Day 29 assessments as close to 2 days after the last dose of investigational product as possible." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToActivity e:u-t01-r008,
            e:u-t01-r009,
            e:u-t01-r010 ;
        st:text "A physical examination will be performed at screening. Abbreviated physical examinations will be performed on day 1 (unless day 1 occurred more than 2 weeks after screening physical examination), Days 15, 29 and 55. Height will be captured once at screening. Weight will be recorded before dialysis." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "Common symptoms associated with hemodialysis will be captured at screening. Any worsening of hemodialysis symptoms will be reported as an adverse event." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-d ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "Investigational product will be administered by intravenous (IV) injection over approximately 30 seconds into the venous line with dialysis rinse back at the end of the dialysis session." .

    e:u-t01-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-e ;
        st:refersToActivity e:u-t01-r013 ;
        st:text "Subjects will remain seated for at least 10 minutes prior to measurement of predialysis heart rate and blood pressure. Vital signs will include blood pressure, heart rate, respiratory rate, and oral or ear temperature. Vital signs will be obtained pre-dialysis treatments on scheduled dialysis days, and at ET and on Day 55 (EOS)." .

    e:u-t01-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-f ;
        st:refersToActivity e:u-t01-r014 ;
        st:text "Subjects will remain supine for at least 5 minutes prior to recording 12-lead electrocardiogram (ECG). Screening 12-lead ECG will be recorded prior to hemodialysis. The Day -2 12-lead ECG will be recorded within 4 hours after hemodialysis rinse back. After the last dose of investigational product on Day 27, 12-lead ECGs will be recorded between 18 and 30 hours (recorded on day 28) post-dose." .

    e:u-t01-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g ;
        st:refersToActivity e:u-t01-r015 ;
        st:text "Adverse events will be monitored and recorded from the dose of investigational product (AMG 416) or placebo. Serious adverse events will be monitored and recorded from the time of informed consent through Day 55." .

    e:u-t01-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-h ;
        st:refersToColumn e:u-t01-c018 ;
        st:text "After Day 28, hemodialysis will continue on study days 29, 31, 34, 36, 38, 41, 43, 45, 48, 50, 52 and 55; data collection and study procedures will only occur on hemodialysis days 29, 34, 41, and 55(EOS)." .

    e:u-t01-n-i a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i ;
        st:refersToActivity e:u-t01-r006 ;
        st:text "Demographic information collected at screening includes sex, age, race, and ethnicity." .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r002,
            e:t02-r002,
            e:t03-r002 ;
        st:propertyName "Study Visit (Day)" ;
        st:propertyType "study_day" .

    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToColumn e:u-t01-c018 ;
        st:text "If a treated subject withdraws from study before completion of dosing, the investigator will make every effort to obtain day 29 samples as close to 2 days after the last dose of investigational product as possible." .

    e:u-t02-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-b ;
        st:refersToActivity e:u-t02-r006,
            e:u-t02-r007,
            e:u-t02-r008,
            e:u-t02-r009,
            e:u-t02-r013 ;
        st:refersToCell e:m-t02-r006-t01-c003,
            e:m-t02-r007-t01-c003,
            e:m-t02-r008-t01-c003,
            e:m-t02-r009-t01-c003,
            e:m-t02-r013-t01-c003 ;
        st:text "If screening albumin, phosphorus, cCa, pregnancy, and iPTH tests occur within 7 days prior to start of IP, then Day -2 lab tests can be waived" .

    e:u-t02-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c ;
        st:refersToActivity e:u-t02-r004 ;
        st:text "Blood sample for PT and aPTT will be drawn prior to heparin administration for dialysis. Day 1 hematology and coagulation tests will be performed only if day 1 occurs more than 2 weeks after the screening hematology and coagulation tests." .

    e:u-t02-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-d ;
        st:refersToActivity e:u-t02-r006,
            e:u-t02-r008 ;
        st:text "Serum samples for albumin and calcium for screening and routine monitoring of predialysis cCa. When albumin is less than 4.0 g/dL, the calcium level will be corrected according to the formula: cCa (mg/dL) = total Ca (mg/dL) + (4 – albumin (g/dL))*0.8. Corrected calcium results will inform dosing/dose withholding at the next hemodialysis treatment." .

    e:u-t02-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-e ;
        st:refersToActivity e:u-t02-r015 ;
        st:text "Perform Kt/V or URR assessment at screening unless a qualifying Kt/V or URR measurement from within 4 weeks prior to screening assessments is available." .

    e:u-t02-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-f ;
        st:refersToActivity e:u-t02-r016 ;
        st:text "Serum samples for anti-drug antibodies will be collected predialysis on days 1, 29, and 55. Any subjects with positive titers for antibodies to AMG 416 may be asked to return to the clinical research unit to provide additional serum samples." .

    e:u-t02-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-g-d01 ;
        st:occurrence e:t02-n-g ;
        st:refersToActivity e:u-t02-r010 ;
        st:text "Luteinizing hormone and estradiol levels may additionally be collected if deemed necessary for confirmation of postmenopausal status as described in exclusion criteria section 4.2.4" .

    e:u-t02-n-t1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-t1 ;
        st:refersToActivity e:u-t02-r004,
            e:u-t02-r005,
            e:u-t02-r006,
            e:u-t02-r007,
            e:u-t02-r008,
            e:u-t02-r009,
            e:u-t02-r010,
            e:u-t02-r011,
            e:u-t02-r012,
            e:u-t02-r013,
            e:u-t02-r014,
            e:u-t02-r015,
            e:u-t02-r016 ;
        st:text "Time: Pre HD" .

    e:u-t03-n-a a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t03-n-a ;
        st:placeholderReason "not_printed" ;
        st:refersToColumn e:u-t01-c018 ;
        st:reviewNote "Probable equivalent (NOT source content for this table): Table 1b footnote a - 'If a treated subject withdraws from study before completion of dosing, the investigator will make every effort to obtain day 29 samples as close to 2 days after the last dose of investigational product as possible.'" ;
        st:text "" .

