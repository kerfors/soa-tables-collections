    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToActivity e:u-t01-r013,
            e:u-t01-r019,
            e:u-t01-r020,
            e:u-t01-r021,
            e:u-t01-r022 ;
        st:text "Specified times are approximate, and actual times will be recorded. Actual sampling time should not exceed 1 hour prior to dosing for the predose sample." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToColumn e:u-t01-c003,
            e:u-t01-c004,
            e:u-t01-c014 ;
        st:text "Period 2, Day -1 procedures (pregnancy tests) and some Period 2, Predose procedures (physical examinations, medical assessments, and clinical laboratory assessments) may be omitted if Period 1, D36 (±1) procedure dates occur within 4 days of Period 2 dosing. Period 2, Day 36 (±1) will also be considered as the final follow-up visit." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToColumn e:u-t01-c015 ;
        st:text "Within 7 to 14 days upon confirmation of early discontinuation." .

    e:u-t01-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g1 ;
        st:text "Note: All sampling times are given relative to dosing (Time 0 hour) with tirzepatide (predose or hours postdose). Unless otherwise indicated, predose procedure may be performed any time prior to dosing." .

    e:u-t01-n-g2 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g2 ;
        st:text "If multiple procedures take place at the same time point, the following order of the procedures should be used: ECGs, vital signs, PK sample (record of actual PK sampling time is the priority), clinical laboratory sample, immunogenicity, blood glucose and pharmacogenetic sample." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:refersToActivity e:u-t01-r005 ;
        st:text "Study drug will be administered after an overnight fast of at least 8 hours." .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n10-d01,
            e:u-t01-n-n10-d02 ;
        st:occurrence e:t01-n-n10 ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "Where applicable, collection times should match with PK sampling time points. In the event of immediate or non-immediate drug hypersensitivity reactions, unscheduled samples will be collected as detailed in Section 9.4.6. Subjects with TE ADA at follow-up/ED will undergo additional follow-up as detailed in Section 9.7." .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11 ;
        st:refersToActivity e:u-t01-r021 ;
        st:text "Performed using a bedside glucose monitor. Additional unscheduled measurements may be taken at the discretion of the investigator where clinically indicated." .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n12 ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "Up to a 10% deviation from the nominal collection time is permissible as long as actual sampling time is recorded." .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToActivity e:u-t01-r006 ;
        st:text "Subjects’ CRU stay may be extended at the investigator’s discretion for safety monitoring." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3 ;
        st:refersToActivity e:u-t01-r009 ;
        st:text "Physical examination at screening. Thereafter, targeted reviews and medical assessments as appropriate." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n4 ;
        st:refersToActivity e:u-t01-r013 ;
        st:text "Single safety ECG will be collected. ECGs must be recorded before collecting any blood samples at each timepoint. Subjects must be supine for approximately 5 to 10 minutes before ECG collection, and remain supine but awake during ECG collection." .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5 ;
        st:refersToActivity e:u-t01-r014 ;
        st:text "Additional time points may be added, if warranted and agreed upon between Lilly and the investigator." .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n6-d01 ;
        st:occurrence e:t01-n-n6 ;
        st:refersToActivity e:u-t01-r015 ;
        st:text "See Appendix 2 for details. Day 1 predose sample is for baseline only." .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Female subjects only. Serum pregnancy test will be performed at screening and urine pregnancy tests at subsequent visits." .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n8 ;
        st:refersToActivity e:u-t01-r017 ;
        st:text "Female subjects considered to be postmenopausal only. Women with confirmed nonchildbearing potential status can be exempted from further pregnancy tests during the study after screening." .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n9 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "Single sample in Period 1 only." .

