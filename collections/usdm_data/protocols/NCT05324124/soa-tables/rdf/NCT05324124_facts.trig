    e:u-t01-c016 a st:UnifiedColumn ;
        st:compositeLabel "Follow-Up phone call / within 7 to 10 days after last dose" ;
        st:member e:t01-c016 ;
        st:propertyValue e:u-t01-c016-v01,
            e:u-t01-c016-v02,
            e:u-t01-c016-v03 ;
        st:segment "main" .

    e:u-t01-n-cm1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-cm1 ;
        st:refersToActivity e:u-t01-r008 ;
        st:text "A study participant may be required to stay later than Day 11 for management or monitoring of an AE or a clinically significant finding, at the discretion of the investigator." .

    e:u-t01-n-cm2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-cm2 ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "Full medical assessment to be performed at screening, and symptom driven examination to be done at other/any time point at physician’s discretion." .

    e:u-t01-n-cm3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-cm3 ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "Height and weight to be measured at screening; weight only to be measured at Day 11 or ED as appropriate." .

    e:u-t01-n-cm4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-cm4 ;
        st:refersToActivity e:u-t01-r013 ;
        st:text "Serum pregnancy tests will be performed at screening and urine pregnancy test at all other time points" .

    e:u-t01-n-cm5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-cm5 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Single ECGs are required." .

    e:u-t01-n-cm6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-cm6 ;
        st:refersToActivity e:u-t01-r017 ;
        st:text "Time points may be added, if warranted and agreed upon between Lilly and the investigator." .

    e:u-t01-n-cm7 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-cm7-d01 ;
        st:occurrence e:t01-n-cm7 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "See Appendix 10.2, Clinical Laboratory Tests, for details." .

    e:u-t01-n-cm8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-cm8 ;
        st:refersToActivity e:u-t01-r020 ;
