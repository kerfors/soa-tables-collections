    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "Include history of blood transfusion within previous 120 days from start of study treatment and the reasons, e.g., bleeding or myelosuppression." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-b-d01 ;
        st:occurrence e:t01-n-b ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "Coagulation test should be performed if clinically indicated. For a list of all required laboratory tests please refer to Section 5.2.1." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToActivity e:u-t01-r014 ;
        st:text "Women of childbearing potential must have a negative urine or serum pregnancy test within 28 days prior to starting treatment and a confirmatory test before treatment on Day 1. If results are positive, the patient is ineligible/must be discontinued from the study." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-d-d01,
            e:u-t01-n-d-d02 ;
        st:occurrence e:t01-n-d ;
        st:refersToActivity e:u-t01-r015 ;
        st:text "Patients must be non-germline BRCA mutated to be enrolled into the study. Patients for whom their gBRCA status is already known should be consented to the study within 28 days prior to Day 1 of study treatment. Patients who do not know their mutation status will need BRCA1/2 mutation screening (see Section 4.1.1 and Appendix F)." .

    e:u-t01-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-e ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Includes CA-125 measurement where required (Refer to Inclusion Criterion 6). RECIST assessment should be performed no more than 28 days before the start of study treatment, and ideally should be performed as close as possible to the start of study treatment." .

    e:u-t01-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-f ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "These measurements may be repeated within the screening period if abnormalities are found which are the only reason for screen failing the patient and which can reasonably be expected to have return to the acceptable range" .

    e:u-t01-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "All patients are required to submit either an archival tumour sample, or a fresh biopsy if an archival sample is not available, for retrospective testing of their genetic status. If archival tissue, the presence of adequate tissue needs to be confirmed prior to screening, but it will not be shipped to the central lab before Day1. If fresh, the biopsy should be taken after the baseline scan has been performed. Samples should be submitted as paraffin blocks, alternatively, sections mounted on glass slides prepared from the block can be provided. Please refer to the laboratory manual for further details regarding tissue collection, shipping and storage." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Note: MRI/ CT scan more than 28 days prior to Day 1 may be acceptable, please consult with AstraZeneca." .

    e:u-t01-r001 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r001,
            e:t02-r001 ;
        st:propertyName "Day" ;
        st:propertyType "study_day" .

    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToColumn e:u-t02-c004,
            e:u-t02-c005 ;
        st:text "From Visit 3 onwards, visits will take place on the first day of each 4-week visit period, relative to the date of the first olaparib dose (if the patient has not progressed and is still on treatment). Where the visit does not coincide with tumour assessment visits, these safety visits will only be for laboratory and pregnancy testing and recording of ECOG status, AEs and concomitant medication including transfusions. Where these visits coincide with tumour assessments, the assessment visit schedule will be performed" .

    e:u-t02-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-b ;
        st:refersToActivity e:u-t01-r010,
            e:u-t01-r011,
            e:u-t01-r012,
            e:u-t01-r013 ;
        st:refersToCell e:m-t01-r010-t02-c002,
            e:m-t01-r011-t02-c002,
            e:m-t01-r012-t02-c002,
            e:m-t01-r013-t02-c002 ;
        st:text "If assessed within 7 days before first dose and meets the stated eligibility criteria (if applicable), it does not need to be repeated on Day 1 of study treatment unless Investigator believes that it is likely to have changed significantly." .

    e:u-t02-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c ;
        st:refersToActivity e:u-t01-r010,
            e:u-t01-r011,
            e:u-t01-r013 ;
        st:text "To be additionally performed if clinically indicated at any other time." .

    e:u-t02-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-d-d01 ;
        st:occurrence e:t02-n-d ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "All samples should be taken prior to first dose. Coagulation test should be performed if clinically indicated. For a list of all required laboratory tests please refer to Section 5.2.1." .

    e:u-t02-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-e-d01 ;
        st:occurrence e:t02-n-e ;
        st:refersToActivity e:u-t01-r014 ;
        st:text "Pregnancy tests on blood or urine samples will be performed for women of childbearing potential within 28 days prior to the start of study treatment, on Day 1 of the study prior to commencing treatment, at the time points shown in Table 2 during study treatment and at the 30-day follow-up visit. If results are positive the patient is ineligible/must be discontinued from study treatment immediately." .

    e:u-t02-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-f ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Visit 4 onwards: Subsequent tumour assessments will be conducted every 8 weeks (±7 days) for the first 12 months and then every 12 weeks (± 7 days) until documented disease progression." .

    e:u-t02-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-g ;
        st:refersToActivity e:u-t02-r012 ;
        st:text "Unless patient was tested at Myriad as part of screening. All patients are required to provide a 9 ml blood sample for confirmation of gBRCA status. Please refer to the laboratory manual for further details regarding blood sample collection,shipping and storage." .

    e:u-t02-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-h ;
        st:refersToActivity e:u-t01-r017 ;
        st:text "All ongoing AEs/SAEs and any new AEs/SAEs identified during the 30 calendar days follow-up period after last dose of study medication must be followed to resolution." .

    e:u-t02-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-j ;
        st:refersToActivity e:u-t02-r016 ;
        st:refersToCell e:m-t02-r016-t02-c003,
            e:m-t02-r016-t02-c004 ;
        st:text "+/- 2 days visit window allowed for the dispensing. Sufficient study treatment should be dispensed for at least each treatment period plus overage; however, additional treatment can be dispensed to patients to last longer if required." .

    e:u-t02-n-k a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-k ;
        st:refersToActivity e:u-t02-r017 ;
        st:text "Start date of the first anticancer treatments (including, but not limited to, chemotherapy and targeted agents), following discontinuation from study treatment must be recorded." .

    e:u-t02-n-l a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-l ;
        st:refersToActivity e:u-t02-r018 ;
        st:text "Patient will be followed (can be by phone or email) regularly until start of subsequent therapy; survival will be followed at approximately 12 weekly intervals thereafter." .

