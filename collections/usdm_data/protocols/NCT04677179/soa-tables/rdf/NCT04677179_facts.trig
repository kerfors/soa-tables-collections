    e:u-t01-n-c1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c1 ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "The purpose of UC remission question should be explained before the participant answers the question. Errors in the response cannot be corrected after the participant saves and confirms the response." .

    e:u-t01-n-c10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c10,
            e:t02-n-c10,
            e:t03-n-c10,
            e:t04-n-c6 ;
        st:refersToActivity e:u-t01-r025 ;
        st:text "Locally performed." .

    e:u-t01-n-c11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c11 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text "Interpreted and reported by radiologist or pulmonologist. Not done at screening if done within 3 months before screening and if qualifying radiographs or equivalent imaging study and/or formal report are available for investigator’s review. Lateral view may also be taken. Locally performed." .

    e:u-t01-n-c12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c12,
            e:t02-n-c12,
            e:t03-n-c12 ;
        st:refersToActivity e:u-t01-r029 ;
        st:text """Check compliance for
Stool Frequency
Rectal Bleeding
Nocturnal Stools
Bristol Stool Scale
Urgency NRS
Abdominal Pain NRS
Fatigue NRS, and
Patient Global Rating of Severity (PGR-S).""" .

    e:u-t01-n-c13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c13 ;
        st:refersToActivity e:u-t01-r036 ;
        st:text "Adapted for the assessment of ideation and behavior categories only." .

    e:u-t01-n-c14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c14 ;
        st:refersToActivity e:u-t01-r038 ;
        st:text "Required if triggered by the Self-Harm Supplement Form per instructions." .

    e:u-t01-n-c15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c15 ;
        st:refersToActivity e:u-t01-r042 ;
        st:text "Fasting samples are preferred, but if participant is non fasting at time of collection, this is not a protocol deviation." .

    e:u-t01-n-c16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c16 ;
        st:refersToActivity e:u-t01-r044 ;
        st:text "Perform only for women of childbearing potential and women with a history of tubal ligation." .

    e:u-t01-n-c17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c17,
            e:t02-n-c17 ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "Perform only for women of childbearing potential and women with a history of tubal ligation. At dosing visits which have pregnancy testing, the pregnancy test result must be confirmed to be negative prior to dosing. Pregnancy testing may be performed more frequently than designated on the SoA, if local laws or regulations require more frequent testing." .

    e:u-t01-n-c18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c18 ;
        st:refersToActivity e:u-t01-r046 ;
        st:text "Optional, perform only for women not of childbearing potential to confirm postmenopausal status." .

    e:u-t01-n-c19 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c19 ;
        st:refersToActivity e:u-t01-r048 ;
        st:text "Patients who had a tuberculin skin test (TST) will return from 48 to 72 hours after placement to have the test result read. Samples may be sent to central or local laboratory based on the type of test. A local laboratory must be qualified by local regulations." .

    e:u-t01-n-c2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c2 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "Includes relevant surgical history." .

    e:u-t01-n-c20 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c20 ;
        st:refersToActivity e:u-t01-r050 ;
        st:text "HCV RNA will be measured to confirm positive hepatitis C virus antibody." .

    e:u-t01-n-c21 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c21 ;
        st:refersToActivity e:u-t01-r051 ;
        st:text "Includes testing for HBsAg and anti-HBc." .

    e:u-t01-n-c22 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c22,
            e:t02-n-c22,
            e:t03-n-c22,
            e:t04-n-c9 ;
        st:refersToActivity e:u-t01-r052 ;
        st:text "Only for participants who are positive for anti-HBc at screening." .

    e:u-t01-n-c23 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c23,
            e:t02-n-c23,
            e:t03-n-c23,
            e:t04-n-c10 ;
        st:refersToActivity e:u-t01-r053,
            e:u-t01-r054,
            e:u-t02-r034,
            e:u-t03-r034,
            e:u-t04-r033 ;
        st:text "Collect samples before dosing, if dosing is scheduled. Collect additional samples at specified times relative to onset of hypersensitivity events." .

    e:u-t01-n-c24 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c24,
            e:t02-n-c24,
            e:t03-n-c24,
            e:t04-n-c11 ;
        st:refersToActivity e:u-t01-r056 ;
        st:text "Blood sample for DNA pharmacogenetics can be obtained any time at or after V2." .

    e:u-t01-n-c25 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c25 ;
        st:refersToActivity e:u-t01-r059 ;
        st:text "Screening endoscopy must occur ≤14 days prior to randomization. At screening, perform only for participants who are eligible for the study by all other study entry criteria." .

    e:u-t01-n-c26 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c26,
            e:t02-n-c26,
            e:t03-n-c26 ;
        st:refersToActivity e:u-t01-r060 ;
        st:text "Performed at time of endoscopy. Instructions for collection are provided in the lab manual. Flexible sigmoidoscopy is recommended, except for protocol-specified reasons when a colonoscopy should be performed." .

    e:u-t01-n-c27 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c27 ;
        st:refersToActivity e:u-t01-r062 ;
        st:text "Additional local stool testing (for example, for ova and parasites) is allowed at the investigator’s discretion." .

    e:u-t01-n-c28 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c28 ;
        st:refersToActivity e:u-t01-r063 ;
        st:text "Additional C. difficile testing is allowed throughout the study at the investigator’s discretion." .

    e:u-t01-n-c29 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c29 ;
        st:refersToActivity e:u-t01-r068 ;
        st:text "No dosing at V3." .

    e:u-t01-n-c3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c3 ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "Indication and history of interest." .

    e:u-t01-n-c4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c4 ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "Includes all UC-specific therapies since date of diagnosis." .

    e:u-t01-n-c5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-c5-d01 ;
        st:occurrence e:t01-n-c5,
            e:t02-n-c5,
            e:t03-n-c5,
            e:t04-n-c3 ;
        st:refersToActivity e:u-t01-r014 ;
        st:text "For AESIs, additional data are collected (Section 8.3.6)." .

    e:u-t01-n-c6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c6 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "Participant should remove shoes." .

    e:u-t01-n-c7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c7 ;
        st:refersToActivity e:u-t01-r021 ;
        st:text "Blood pressure, body temperature, and pulse rate. Vital signs should be measured after participant has been sitting at least 5 minutes." .

    e:u-t01-n-c8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-c8-d01 ;
        st:occurrence e:t01-n-c8 ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "The complete physical exam excludes pelvic, rectal, and breast exams, unless clinically indicated, and includes assessment for signs and symptoms of tuberculosis (TB), including peripheral lymph nodes. See Section 8.2.2." .

    e:u-t01-n-c9 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-c9-d01 ;
        st:occurrence e:t01-n-c9,
            e:t02-n-c9,
            e:t03-n-c9,
            e:t04-n-c5 ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "See Section 8.2.2." .

    e:u-t01-n-t1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-t1 ;
        st:refersToColumn e:u-t01-c002,
            e:u-t01-c010 ;
        st:text "V1 and V9 procedures may be conducted over more than 1 day as long as all activities are completed within the allowable visit tolerance and all scheduled activities are completed prior to dosing." .

    e:u-t01-n-t2 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-t2-d01 ;
        st:occurrence e:t01-n-t2,
            e:t02-n-t2,
            e:t03-n-t2 ;
        st:text "For procedures at an ETV, see ETV in Table 4." .

    e:u-t01-n-t3 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-t3-d01 ;
        st:occurrence e:t01-n-t3,
            e:t02-n-t4,
            e:t03-n-t4 ;
        st:text "For procedures at an unscheduled visit, see V997 in Table 4." .

    e:u-t01-r001 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r001,
            e:t02-r001,
            e:t03-r001,
            e:t04-r001 ;
        st:propertyName "Visit number" ;
        st:propertyType "visit" .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002,
            e:t02-r002,
            e:t03-r002,
            e:t04-r002 ;
        st:propertyName "Weeks from randomization" ;
        st:propertyType "week" .

    e:u-t01-r003 a st:UnifiedProperty ;
        st:level 3 ;
        st:member e:t01-r003,
            e:t02-r003,
            e:t03-r003 ;
        st:propertyName "Study day" ;
        st:propertyType "study_day" .

    e:u-t01-r004 a st:UnifiedProperty ;
        st:member e:t01-r004,
            e:t02-r004,
            e:t03-r004,
            e:t04-r004 ;
        st:propertyName "Visit interval tolerance (days)" ;
        st:propertyType "window" .

    e:u-t02-n-c15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c15,
            e:t03-n-c15 ;
        st:refersToActivity e:u-t01-r042 ;
        st:text "Fasting samples are preferred, but if participant is nonfasting at time of collection, this is not a protocol deviation." .

    e:u-t02-n-c29 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c29,
            e:t03-n-c29 ;
        st:refersToActivity e:u-t01-r068 ;
        st:text "No dosing at V29." .

    e:u-t02-n-c30 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c30 ;
        st:refersToActivity e:u-t01-r058 ;
        st:text "Not applicable for responders during the time period of V10 through V19" .

    e:u-t02-n-c7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c7,
            e:t03-n-c7,
            e:t04-n-c4 ;
        st:refersToActivity e:u-t01-r021 ;
        st:text "Blood pressure, body temperature, and pulse rate. Vital signs should be measured after participant has been sitting for at least 5 minutes." .

    e:u-t02-n-t1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-t1 ;
        st:text "This schedule applies to study participants who are responders at Week 12." .

    e:u-t02-n-t3 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t02-n-t3-d01 ;
        st:occurrence e:t02-n-t3 ;
        st:text "For procedures at an early termination visit, see ETV in Table 4." .

    e:u-t02-n-t5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-t5 ;
        st:refersToColumn e:u-t02-c002,
            e:u-t02-c003,
            e:u-t02-c004,
            e:u-t02-c005,
            e:u-t02-c006,
            e:u-t02-c007,
            e:u-t02-c008,
            e:u-t02-c009,
            e:u-t02-c010,
            e:u-t02-c011 ;
        st:text "Visits 10 through 28 are eligible to be conducted remotely (that is, by telephone, IT-assisted virtual visit, mobile healthcare, or a combination thereof), if written approval is provided by the sponsor and according to the preferences of the participant and the study site. However, no more than 34 days can elapse without an on-site study visit occurring." .

    e:u-t02-n-t6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-t6 ;
        st:refersToColumn e:u-t02-c012,
            e:u-t02-c013,
            e:u-t02-c014,
            e:u-t02-c015,
            e:u-t02-c016,
            e:u-t02-c017,
            e:u-t02-c018,
            e:u-t02-c019,
            e:u-t02-c020 ;
        st:text "Visits 10 through 28 are eligible to be conducted remotely (that is, by telephone, IT-assisted virtual visit, mobile healthcare, or a combination thereof) if written approval is provided by the sponsor and according to the preferences of the participant and the study site. However, no more than 34 days can elapse without an on-site study visit occurring." .

    e:u-t03-n-c17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-c17,
            e:t04-n-c8 ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "Perform only for women of childbearing potential and women with a history of tubal ligation. At dosing visits which have pregnancy testing, the pregnancy test result must be confirmed to be negative prior to dosing. Pregnancy testing may be performed more frequently than designated on the SoA if local laws or regulations require more frequent testing." .

    e:u-t03-n-t1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-t1 ;
        st:text "This schedule applies to study participants who are nonresponders at Week 12." .

    e:u-t03-n-t5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-t5 ;
        st:refersToColumn e:u-t03-c009,
            e:u-t03-c010,
            e:u-t03-c011 ;
        st:text "Visits 17 through 28 are eligible to be conducted remotely (that is, by telephone, IT-assisted virtual visit, mobile healthcare, or a combination thereof) if written approval is provided by the sponsor and according to the preferences of the participant and the study site. However, no more than 34 days can elapse without an on-site study visit occurring." .

    e:u-t03-n-t6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-t6 ;
        st:refersToColumn e:u-t03-c012,
            e:u-t03-c013,
            e:u-t03-c014,
            e:u-t03-c015,
            e:u-t03-c016,
            e:u-t03-c017,
            e:u-t03-c018,
            e:u-t03-c019,
            e:u-t03-c020 ;
        st:text "Visits 17 through 28 are eligible to be conducted remotely (that is, by telephone, IT-assisted virtual visit, mobile healthcare, or a combination thereof) if written approval is provided by the sponsor and according to the preferences of the participant and the study site. However, no more than 34 days can elapse without an on-site study visit occurring" .

    e:u-t03-n-t7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-t7 ;
        st:refersToColumn e:u-t03-c008 ;
        st:text "V16 procedures may be conducted over more than 1 day as long as all activities are completed within the allowable visit tolerance and all scheduled activities are completed prior to dosing" .

    e:u-t04-n-c1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c1 ;
        st:refersToColumn e:u-t04-c004,
            e:u-t04-c005 ;
        st:text "The intervals between ETV and the post-treatment follow-up visit(s) should be adequate to ensure that V801 occurs at least 8 weeks since last dose and V802 (if applicable) occurs at least 16 weeks since last dose." .

    e:u-t04-n-c12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c12 ;
        st:refersToActivity e:u-t01-r059 ;
        st:refersToCell e:m-t01-r059-t04-c002 ;
        st:text "Recommended at ETV based on judgment of the investigator and after discussion with the sponsor’s medical monitor. If not performed at ETV, this will not be considered a protocol deviation." .

    e:u-t04-n-c13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c13 ;
        st:refersToActivity e:u-t01-r060 ;
        st:refersToCell e:m-t01-r060-t04-c002 ;
        st:text "Recommended at ETV based on judgment of the investigator and after discussion with the sponsor’s medical monitor." .

    e:u-t04-n-c14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c14 ;
        st:refersToActivity e:u-t01-r068 ;
        st:text "No dosing at ETV, V997, or post-treatment follow-up visits." .

    e:u-t04-n-c15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c15 ;
        st:refersToActivity e:u-t01-r021 ;
        st:refersToCell e:m-t01-r021-t04-c003 ;
        st:text "V997: Vital signs collection is optional." .

    e:u-t04-n-c16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c16 ;
        st:refersToActivity e:u-t01-r060 ;
        st:text "Instructions for collection are provided in the lab manual. Flexible sigmoidoscopy is recommended, except for protocol-specified reasons when a colonoscopy should be performed." .

    e:u-t04-n-c17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c17 ;
        st:refersToActivity e:u-t01-r060 ;
        st:refersToCell e:m-t01-r060-t04-c002 ;
        st:text "If not performed at ETV, this will not be considered a protocol deviation." .

    e:u-t04-n-c2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c2 ;
        st:refersToProperty e:u-t01-r005 ;
        st:text "No fasting in this period" .

    e:u-t04-n-c7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-c7 ;
        st:refersToActivity e:u-t01-r042 ;
        st:refersToCell e:m-t01-r042-t04-c002 ;
        st:text "Fasting is not required for the lipid panel at ETV." .

    e:u-t04-n-t1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-t1 ;
        st:refersToColumn e:u-t04-c005 ;
        st:text "V802 is only for randomized participants who were positive for anti-HBc at screening. All other participants will have their final visit at V801 or ETV." .

    e:u-t04-n-t2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t04-n-t2 ;
        st:refersToColumn e:u-t04-c003 ;
        st:text "V997: Additional study procedures can be performed at the discretion of the investigator." .

    e:u-t04-r003 a st:UnifiedProperty ;
        st:member e:t04-r003 ;
        st:propertyName "Study day" ;
        st:propertyType "study_day" .

