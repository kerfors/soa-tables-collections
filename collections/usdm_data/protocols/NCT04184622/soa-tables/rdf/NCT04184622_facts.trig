    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1,
            e:t02-n-n1 ;
        st:refersToProperty e:u-t01-r001,
            e:u-t01-r004 ;
        st:text "On all office visits, study participants should be reminded to report to the site before taking study drug (s) in a fasting condition, after a period of approximately 8 hours without eating, drinking (except water), or any significant physical activity. Since some screening procedures need to be completed in the fasting state, Visit 1 may be conducted over more than 1 day to ensure necessary conditions are met." .

    e:u-t01-n-n10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n10-d01 ;
        st:occurrence e:t01-n-n10,
            e:t02-n-n10 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Vital-sign measurements should be taken before obtaining an ECG tracing and before collection of blood samples for laboratory testing, per the instruction in Section 10.7." .

    e:u-t01-n-n11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n11,
            e:t02-n-n11 ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "All training should be repeated as needed to ensure participant compliance." .

    e:u-t01-n-n12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n12,
            e:t02-n-n12 ;
        st:refersToActivity e:u-t01-r021 ;
        st:text "Data from diary, as well as study drug compliance, should be reviewed." .

    e:u-t01-n-n13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n13,
            e:t02-n-n13 ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "Counselling on diet and exercise, to be performed by a dietician or equivalent qualified delegate, to include calculation of individualized energy requirement and methods to change dietary composition and amount of physical activity. The Lifestyle Program Instruction may be delivered on a separate day from the rest of that visit’s study procedures but must occur within the visit window. Beginning at Week 8, the Lifestyle Program Instruction may be delivered by phone." .

    e:u-t01-n-n14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n14,
            e:t02-n-n14 ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "All training should be repeated as needed to ensure participant compliance. Study personnel to provide reinforcement and encouragement for lifestyle modifications." .

    e:u-t01-n-n15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n15 ;
        st:refersToActivity e:u-t01-r024 ;
        st:text "All training should be repeated as needed to ensure participant compliance" .

    e:u-t01-n-n16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n16 ;
        st:refersToActivity e:u-t01-r025 ;
        st:refersToCell e:m-t01-r025-t01-c022 ;
        st:text "This applies only to those participants going into the additional 2-year treatment period for participants with prediabetes at randomization." .

    e:u-t01-n-n17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n17 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text "Participants should administer their first dose of study drug at the end of the Visit 3, after other study procedures are completed" .

    e:u-t01-n-n18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n18 ;
        st:refersToActivity e:u-t01-r029 ;
        st:text "A serum pregnancy test will be performed at Visit 1 for women of childbearing potential only." .

    e:u-t01-n-n19 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n19,
            e:t02-n-n19 ;
        st:refersToActivity e:u-t01-r030 ;
        st:text "A urine pregnancy test must be performed at Visit 3 with the result available prior to randomization and first injection of study drug(s) for women of childbearing potential only. Additional pregnancy tests (beyond those required per the Schedule of Activities) should be performed at any time during the trial if a menstrual period is missed, there is clinical suspicion of pregnancy, or as required by local law or regulation." .

    e:u-t01-n-n2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n2 ;
        st:refersToColumn e:u-t01-c004 ;
        st:text "Baseline assessments must be completed before processing in the IWRS." .

    e:u-t01-n-n20 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n20 ;
        st:refersToActivity e:u-t01-r031 ;
        st:text "Follicle-stimulating hormone test performed at Visit 1 for postmenopausal women at least 40 years of age with an intact uterus, not on hormone therapy, and who have had spontaneous amenorrhea for more than 1 year without an alternative medical cause." .

    e:u-t01-n-n21 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n21,
            e:t02-n-n21 ;
        st:refersToActivity e:u-t01-r032 ;
        st:text "2-hour OGTT testing should be omitted at visits following a protocol-defined diabetes diagnosis." .

    e:u-t01-n-n22 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n22 ;
        st:refersToActivity e:u-t01-r038,
            e:u-t01-r039,
            e:u-t01-r040,
            e:u-t01-r041,
            e:u-t01-r044 ;
        st:refersToCell e:m-t01-r038-t01-c002,
            e:m-t01-r039-t01-c002,
            e:m-t01-r040-t01-c002,
            e:m-t01-r041-t01-c002,
            e:m-t01-r044-t01-c002 ;
        st:text "Screening visit assessment will be used to confirm eligibility. If calcitonin results are not available, a final review of eligibility will occur at Visit 3 before randomization can proceed." .

    e:u-t01-n-n23 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n23,
            e:t02-n-n23 ;
        st:refersToActivity e:u-t01-r033 ;
        st:text "The CKD-EPI equation will be used by the central lab to estimate and report eGFR." .

    e:u-t01-n-n24 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n24,
            e:t02-n-n24 ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "PK samples for immunogenicity must be taken prior to drug administration at these visits. In the event of systemic drug hypersensitivity reactions (immediate or nonimmediate), additional blood samples will be collected including ADA, PK, and exploratory biomarker samples." .

    e:u-t01-n-n25 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n25 ;
        st:refersToActivity e:u-t01-r046 ;
        st:text "PK samples will be collected at these visits at time windows of 1 to 24 hours, 24 to 96 hours, or 120 to 168 hours post dose, as assigned by IWRS at randomization. Dependent on the time windows to which a participant is assigned, they may be required to come to site for PK-specific visits." .

    e:u-t01-n-n26 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n26,
            e:t02-n-n26 ;
        st:refersToActivity e:u-t01-r050,
            e:u-t01-r051,
            e:u-t01-r052,
            e:u-t01-r053 ;
        st:text "The C-SSRS, Self-Harm Supplement Form and PHQ-9 should be administered after assessment of adverse events. For this study, the C-SSRS is adapted for the assessment of the ideation and behavior categories only. The Intensity of Ideation and Lethality of Behavior sections are removed." .

    e:u-t01-n-n27 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n27,
            e:t02-n-n27 ;
        st:refersToActivity e:u-t01-r054 ;
        st:text "Self-Harm Follow-up Form is only required if triggered by the Self-Harm Supplement Form, per instructions in the form." .

    e:u-t01-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n3,
            e:t02-n-n3 ;
        st:refersToColumn e:u-t01-c023,
            e:u-t02-c018 ;
        st:text "Participants wanting to discontinue the study before Week 72 will be asked to return for Visit 99 at 72 weeks ± 7 days after randomization primarily for body weight measurement and assessment of adverse events. If the participant is unwilling to attend Visit 99, it should be documented in the participant medical record that the participant has refused to attend. Participants wanting to discontinue the study after Week 72 but before Week 176 will be asked to return for Visit 199 primarily for the body weight measurement and assessment of adverse events. Refusal to attend should be documented." .

    e:u-t01-n-n4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n4,
            e:t02-n-n4 ;
        st:refersToColumn e:u-t01-c024,
            e:u-t02-c019 ;
        st:text "Participants who are unable or unwilling to continue the study treatment for any reason will perform an ED visit. If the participant is discontinuing during an unscheduled visit or a scheduled visit, that visit should be performed as the ED visit." .

    e:u-t01-n-n5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n5,
            e:t02-n-n5 ;
        st:refersToColumn e:u-t01-c025,
            e:u-t02-c020 ;
        st:text "For participants who discontinue or complete the study within the first 72 weeks, Visit 801 (safety follow-up visit) should be performed 4 weeks after the last visit during the 72-week treatment period. Participants with prediabetes continuing to Week 78 should not perform Visit 801. For participants with prediabetes who complete the 176 weeks or discontinue after Week 72, Visit 802 should be performed 17 weeks after the last visit during the additional 2-year treatment period for participants with prediabetes at randomization." .

    e:u-t01-n-n6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n6,
            e:t02-n-n6 ;
        st:refersToProperty e:u-t01-r003 ;
        st:text "The visit date is determined in relation to the date of the randomization visit (± the allowed visit window)." .

    e:u-t01-n-n7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n7 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "Medical history includes assessment of preexisting conditions (for example, history of gallbladder disease, cardiovascular disease, and medullary thyroid carcinoma) and substance usage (such as alcohol and tobacco)." .

    e:u-t01-n-n8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n8-d01 ;
        st:occurrence e:t01-n-n8,
            e:t02-n-n8 ;
        st:refersToActivity e:u-t01-r013 ;
        st:text "Weight measurements should be obtained per the instructions in Section 10.7. Body weight must be measured in fasting state. If the participant is not fasting, the participant should be called in for a new visit within the visit window to have the fasting body weight measured." .

    e:u-t01-n-n9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-n9-d01 ;
        st:occurrence e:t01-n-n9,
            e:t02-n-n9 ;
        st:refersToActivity e:u-t01-r015 ;
        st:text "ECG measurements should be obtained per the instructions in Section 10.7. ECGs will be performed in triplicate at Weeks 0 and 36. All other ECGs will be single measurements. ECGs should be collected at least 30 minutes prior to collection of blood samples for laboratory testing, including PK samples." .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002,
            e:t02-r002 ;
        st:propertyName "Week of Treatment" ;
        st:propertyType "week" .

    e:u-t01-r005 a st:UnifiedProperty ;
        st:member e:t01-r005,
            e:t02-r005 ;
        st:propertyName "Telephone Visit" ;
        st:propertyType "modality" .

