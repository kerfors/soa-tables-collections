    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c016 ;
        st:text "Short-term follow-up begins when the participant and investigator agree that the participant will no longer continue study treatment and lasts a minimum of 30 days following the last dose of study drug." .

    e:u-t01-n-i1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i1 ;
        st:refersToColumn e:u-t01-c010,
            e:u-t01-c015 ;
        st:text "D22 for 28-day cycles only." .

    e:u-t01-n-i10 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-i10-d01 ;
        st:occurrence e:t01-n-i10 ;
        st:refersToActivity e:u-t01-r018,
            e:u-t01-r020 ;
        st:text "See Appendix 2." .

    e:u-t01-n-i11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i11-d01 ;
        st:occurrence e:t01-n-i11 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "See Appendix 2. Perform at baseline, C2D1, D1 of every other cycle afterwards (C4D1, C6D1, etc.), and as clinically indicated." .

    e:u-t01-n-i12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i12-d01 ;
        st:occurrence e:t01-n-i12 ;
        st:refersToActivity e:u-t01-r021 ;
        st:text "See Appendix 2. In addition, perform as clinically indicated." .

    e:u-t01-n-i13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i13-d01 ;
        st:occurrence e:t01-n-i13 ;
        st:refersToActivity e:u-t01-r022 ;
        st:text """• Applies only to women of childbearing potential.
• Note: During study treatment, perform monthly or as required per local regulations and/or institutional guidelines.
See Appendix 2.""" .

    e:u-t01-n-i14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i14-d01 ;
        st:occurrence e:t01-n-i14 ;
        st:refersToActivity e:u-t01-r023 ;
        st:text "See Appendix 2. Starting C1D1, then every 3 months thereafter." .

    e:u-t01-n-i15 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i15 ;
        st:refersToActivity e:u-t01-r024 ;
        st:text """• Perform according to RECIST 1.1, by the same method used at baseline, every 8 weeks (±7 days) for the first 6 months after C1D1 and every 12 weeks (±7 days) thereafter until radiographic disease progression, death, or study completion, whichever occurs first.
Perform as scheduled, even if study treatment is delayed or omitted.""" .

    e:u-t01-n-i16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i16-d01 ;
        st:occurrence e:t01-n-i16 ;
        st:refersToActivity e:u-t01-r025 ;
        st:text """Prior to each injection and at the designated timepoints, the investigator/investigator designee will ask the participant if they have any injection site concerns and record the participant’s response.
1.Cycle 1 collection:
a.C1D1: 5-15 min after injection is complete and 60 min after injection is complete
b.C1D2 (approximately 24 hr after injection)
c.C1D4 (± 1 day)
d.C1D8: 5-15 min after injection and 60 min after injection
e.C1D15: 5-15 min after injection and 60 min after injection
2.Cycle 2-n collection:
a.5-15 min after injection and 60 min after injection
The findings from the assessment are recorded on the ISR questionnaire. All positive responses of pain require an additional assessment using the participant-completed Pain VAS. If there are ≥2 injections, the ISR questionnaire will be filled out separately for each site, after all injections have been administered. See Section 8.2.5 for details.""" .

    e:u-t01-n-i17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i17 ;
        st:refersToActivity e:u-t01-r026 ;
        st:text """1. ISR questionnaire completed outside of solicited assessment schedule.
2. May be triggered by participant anytime during the cycle based on diary.
3. If the participant indicates presence of pain during spontaneous ISR reporting, no VAS assessment is required.""" .

    e:u-t01-n-i18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i18 ;
        st:refersToActivity e:u-t01-r027 ;
        st:text """• Participant will assess injection site(s) daily. If any ISR symptoms present, the participant should contact the investigator.
• Diary should be returned to the investigator at each weekly visit.""" .

    e:u-t01-n-i19 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-i19-d01 ;
        st:occurrence e:t01-n-i19 ;
        st:refersToActivity e:u-t01-r028 ;
        st:text "See Section 1.3.1 for PK and IG." .

    e:u-t01-n-i2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i2 ;
        st:refersToActivity e:u-t01-r008 ;
        st:text "ICF must be signed before any protocol-specific procedures are performed" .

    e:u-t01-n-i20 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i20-d01 ;
        st:occurrence e:t01-n-i20 ;
        st:refersToActivity e:u-t01-r031 ;
        st:text "See Section 6.1. Participants must be closely monitored for a 1-hour observation period following the administration of SC ramucirumab (see Section 6.1)." .

    e:u-t01-n-i21 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i21-d01 ;
        st:occurrence e:t01-n-i21 ;
        st:refersToActivity e:u-t01-r032 ;
        st:text "Begin Combination anti-cancer therapies along with weekly SC ramucirumab at Cycle-2. See details in Section 6.1. Erlotinib (1L EGFR+ NSCLC), docetaxel (2L NSCLC), paclitaxel (2L gastric), FOLFIRI (2L CRC)." .

    e:u-t01-n-i3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i3 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "Including assessment of preexisting conditions, historical illnesses, and habits (such as tobacco and alcohol use)." .

    e:u-t01-n-i4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i4 ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "Record prior anti-cancer therapy" .

    e:u-t01-n-i5 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i5 ;
        st:refersToActivity e:u-t01-r012 ;
        st:text """• At baseline, record prior and concurrent medications.
• Record all premedication, supportive care, and concomitant medication continuously at every visit and throughout the study.""" .

    e:u-t01-n-i6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i6 ;
        st:refersToActivity e:u-t01-r014 ;
        st:text """Measure vital signs (height [at baseline], weight, temperature, blood pressure, pulse rate, and respiration rate).
On days with concurrent ECGs, vital signs, and/or PK sampling, these measurements should occur at approximately the same time.
Vital sign measurements will be obtained:
• Day 1 at predose (prior to SC ramucirumab dose, but within 90 minutes prior to predose blood draw)
• C1D2 (24 hours postdose)
• C1D8
• C1D15
• Any time for other specified visits, but prior to SC ramucirumab dose at same visit.""" .

    e:u-t01-n-i7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-i7-d01 ;
        st:occurrence e:t01-n-i7 ;
        st:refersToActivity e:u-t01-r015 ;
        st:text """• Collect continuously at every visit and throughout the study.
• CTCAE Version 5.0
• See Section 10.3 for AE grading for lab investigations.""" .

    e:u-t01-n-i8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i8 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "During study treatment, perform ≤3 days prior to treatment." .

    e:u-t01-n-i9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i9 ;
        st:refersToActivity e:u-t01-r017 ;
        st:text """Single, local.
On days with concurrent measurements, see vital sign row for more details. Times are referenced to the end of dosing.
ECGs will be obtained:
• C1D1 at predose.
• Every 6 weeks thereafter, predose.
• Any other time as clinically indicated.""" .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:refersToColumn e:u-t01-c011 ;
        st:text "Note: For applicable participants who have their combination therapy held while SC weekly ramucirumab is continued, procedures noted in column DX are to be performed at the time of the additional ramucirumab doses." .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 1 ;
        st:member e:t01-r002,
            e:t02-r002,
            e:t03-r001 ;
        st:propertyName "Epoch" ;
        st:propertyType "epoch" .

    e:u-t01-r003 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r003,
            e:t02-r003 ;
        st:propertyName "Cycle length" ;
        st:propertyType "other" .

    e:u-t01-r004 a st:UnifiedProperty ;
        st:level 3 ;
        st:member e:t01-r004 ;
        st:propertyName "Cycle" ;
        st:propertyType "cycle" .

    e:u-t01-r005 a st:UnifiedProperty ;
        st:member e:t01-r005 ;
        st:propertyName "Visit window" ;
        st:propertyType "window" .

    e:u-t01-r006 a st:UnifiedProperty ;
        st:level 4 ;
        st:member e:t01-r006 ;
        st:propertyName "Day" ;
        st:propertyType "study_day" .

    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToColumn e:u-t02-c003 ;
        st:text "Continued-access follow-up begins when the participant and the investigator agree that the participant will no longer continue treatment in the continued-access period and lasts a minimum of 30 days following the last dose of study drug. In all cases, no follow-up procedures will be performed for a participant who withdraws informed consent unless he or she has explicitly provided permission and consent." .

    e:u-t02-n-i1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-i1-d01 ;
        st:occurrence e:t02-n-i1 ;
        st:refersToActivity e:u-t01-r015 ;
        st:text "Grading via CTCAE, Version 5.0. As part of AE collection, monitor vital signs and perform standard laboratory tests (hematology, chemistry, urinalysis, and pregnancy testing) at the same frequency as during the study treatment period. See Section 10.3 for AE grading for lab investigations. All laboratory tests during the continued access period will be performed in the local laboratories only." .

    e:u-t02-n-i2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-i2 ;
        st:refersToActivity e:u-t02-r006 ;
        st:text "In the event of hypersensitivity, blood samples will be collected for PK, IG, and exploratory hypersensitivity analyses at the following time points, as close as possible to: (i) the onset of the hypersensitivity, (ii) the resolution of the hypersensitivity, and (iii) 30 (±3) days following the hypersensitivity." .

    e:u-t02-n-i3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t02-n-i3-d01 ;
        st:occurrence e:t02-n-i3 ;
        st:refersToActivity e:u-t01-r031 ;
        st:text "See Section 6.1. Participants must be closely monitored for a 1-hour observation period following the ramucirumab injection (see Section 6.1)." .

    e:u-t03-n-g1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-g1 ;
        st:text "The pharmacokinetic sampling table applies to all participants irrespective of 21-day or 28-day cycle length." .

    e:u-t03-n-g2 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-g2 ;
        st:text "Adequately record the actual collection date and time (24-hour clock; for example, 16:00, not 4 pm) on the requisition form of the sample." .

    e:u-t03-n-g3 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-g3 ;
        st:text """In case of cycle delay and/or ramucirumab dosing interruption, if possible, collect an additional unscheduled PK samples using the appropriate central lab collection kit:
• at time as close as possible to the onset of the adverse event (AE) (if the cycle delay or ramucirumab dosing interruption is due to an AE).
• at the time when ramucirumab dose should have been administered (if there had not been a delay or dose interruption).
• prior to resuming the ramucirumab dosing after dosing interruption/dosing delay.""" .

    e:u-t03-n-g4 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-g4 ;
        st:text "Note: If the above time points for unscheduled PK sampling happen to occur at the same time as a scheduled PK time point (see table below), then only the scheduled sample will be taken." .

    e:decision-ccorr-002 a st:Decision ;
        st:decidedAt "2026-10-04T08:20:00Z"^^xsd:dateTime ;
        st:decidedByPerson "Kerstin Forsberg" ;
        st:decisionSource e:t03-r002 ;
