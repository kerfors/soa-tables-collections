        st:refersToCell e:m-t02-r013-t02-c005,
            e:m-t02-r013-t02-c010,
            e:m-t02-r013-t02-c013,
            e:m-t02-r013-t02-c018 ;
        st:text "Sample collected just before actual end of infusion of isatuximab." .

    e:u-t02-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-g ;
        st:refersToActivity e:u-t02-r016 ;
        st:refersToCell e:m-t02-r013-t02-c008,
            e:m-t02-r013-t02-c009,
            e:m-t02-r013-t02-c011,
            e:m-t02-r013-t02-c014,
            e:m-t02-r013-t02-c016,
            e:m-t02-r013-t02-c020 ;
        st:text "Isatuximab sample collected strictly before the start of isatuximab infusion (during treatment phase)." .

    e:u-t02-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-h ;
        st:refersToActivity e:u-t02-r016 ;
        st:refersToCell e:m-t02-r016-t02-c023 ;
        st:text "After FUP 90(±7) days after last isatuximab administration no further ADA will be sampled even if the status is positive or inconclusive." .

    e:u-t02-n-i a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-i ;
        st:refersToActivity e:u-t02-r011,
            e:u-t02-r013,
            e:u-t02-r014,
            e:u-t02-r016 ;
        st:text "Isatuximab PK and ADA samples to be collected each cycle until the last study treatment for PK and until FUP 90(±7) days after last IMP administration for ADA or at the cut-off date, whichever comes first. However, collection can be reduced or stopped earlier upon notification from the Sponsor based on the updated knowledge of isatuximab on PK/ADA." .

    e:u-t02-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-j ;
        st:refersToActivity e:u-t02-r012,
            e:u-t02-r015 ;
        st:refersToCell e:m-t02-r012-t02-c020,
            e:m-t02-r015-t02-c020 ;
        st:text "For subsequent cycles, atezolizumab PK and ADA samples (pre-dose) are to be collected at Cycle 8 Day 1 and Cycle 16 Day 1 only." .

