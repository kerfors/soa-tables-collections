    e:u-t03-n-n3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t03-n-n3 ;
        st:refersToActivity e:u-t03-r012 ;
        st:text "Mandatory for all GBM participants. For HCC, SCCHN, and EOC participants, provision of adequate archival tumor tissue is allowed to replace mandatory baseline biopsy" .

    e:u-t03-n-n4 a st:UnifiedAnnotation ;
