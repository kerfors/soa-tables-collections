    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c009 ;
        st:text "Samples for immunogenicity, should be collected every 12 weeks (84±7 days) until the titer returns to baseline (ie, returns to within a single 2-fold dilution of the baseline titer) or until 1 year after the last dose of study treatment. A time-matched PK (glucagon) sample may be collected at the follow-up immunogenicity assessment(s) if warranted and agreed upon between both the investigator and sponsor." .

    e:u-t01-n-c1 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c1 ;
        st:refersToActivity e:u-t01-r006 ;
        st:text "Admission can be rescheduled if PG level is not 90 to 250 mg/dL on Day 1." .

    e:u-t01-n-c10 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c10 ;
        st:refersToActivity e:u-t01-r017 ;
        st:text "Once bedside PG reaches <60 mg/dL, the insulin infusion is stopped and approximately 5 minutes later study drug is administered. Indicates Time = 0 min." .

    e:u-t01-n-c11 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c11 ;
        st:refersToActivity e:u-t01-r018 ;
        st:text "Injection-site assessment for IMG only." .

    e:u-t01-n-c12 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c12 ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "Nasal inspection both for IMG and LY900018." .

    e:u-t01-n-c13 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c13 ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "Time points may be added for each period if warranted and agreed upon between Lilly and the investigator. Predose time point will be between insulin infusion stop and study treatment." .

    e:u-t01-n-c14 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c14 ;
        st:refersToActivity e:u-t01-r022 ;
        st:text "Time points may be added for Period 1 and Period 2 if warranted and agreed upon between Lilly and the investigator. Predose time point will be between insulin infusion stop and study treatment." .

    e:u-t01-n-c15 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-c15-d01 ;
        st:occurrence e:t01-n-c15 ;
        st:refersToActivity e:u-t01-r024,
            e:u-t01-r026 ;
        st:text "See Appendix 2, Clinical Laboratory Tests, for details." .

    e:u-t01-n-c16 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-c16-d01 ;
        st:occurrence e:t01-n-c16 ;
        st:refersToActivity e:u-t01-r025 ;
        st:text "See Appendix 2, Clinical Laboratory Tests, for details. Patients do not need to fast for samples at screening or follow-up. At Periods 1 and 2, samples should be collected from patients who have fasted at least 8 hours before any study procedures." .

    e:u-t01-n-c17 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c17 ;
        st:refersToActivity e:u-t01-r027 ;
        st:text "Serum pregnancy test will be performed at screening. Urine pregnancy test will be performed at every admission period and follow-up visit if applicable." .

    e:u-t01-n-c18 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c18 ;
        st:refersToActivity e:u-t01-r028 ;
        st:text "When needed to confirm postmenopausal status." .

    e:u-t01-n-c19 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c19 ;
        st:refersToActivity e:u-t01-r029,
            e:u-t01-r030 ;
        st:text "Additional tests can be done at the discretion of the investigator." .

    e:u-t01-n-c2 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c2 ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "Patient may be discharged 6 hours after glucagon administration. A patient may remain inpatient at the CRU at the discretion of the investigator." .

    e:u-t01-n-c20 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c20 ;
        st:refersToActivity e:u-t01-r031 ;
        st:text "Sampling times are relative to the time of study treatment administration (0 min). Predose time point will be between insulin infusion stop and study treatment." .

    e:u-t01-n-c21 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c21 ;
        st:refersToActivity e:u-t01-r032 ;
        st:text "-5 mins = stop insulin infusion. Sampling times are relative to the time of study treatment administration (0 min). Predose time point will be between insulin infusion stop and study treatment." .

    e:u-t01-n-c22 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c22 ;
        st:refersToActivity e:u-t01-r033 ;
        st:text "Single sample for pharmacogenetic analysis taken prior to/on Period 1 Day -1." .

    e:u-t01-n-c23 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-c23-d01 ;
        st:occurrence e:t01-n-c23 ;
        st:refersToActivity e:u-t01-r034 ;
        st:text "In the event of drug hypersensitivity reactions (immediate or non-immediate), samples will be collected as close to event onset as possible, at event resolution, and 30 days following the event. Patients with TE ADA at follow-up/ED will undergo additional follow-up. Refer to Section 9.7.1 for details." .

    e:u-t01-n-c24 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c24 ;
        st:refersToActivity e:u-t01-r037 ;
        st:text "Sampling times are relative to the time of study treatment administration (0 min). Questionnaire will be collected in both LY900018 and IMG treatment groups in both periods." .

    e:u-t01-n-c25 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c25 ;
        st:refersToActivity e:u-t01-r038 ;
        st:text "Sampling times are relative to the time of study treatment administration (0 min). During hypoglycemia induction will be when PG ≤75 mg/dL. Predose time point will be between insulin infusion stop and study treatment." .

    e:u-t01-n-c3 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c3 ;
        st:refersToActivity e:u-t01-r010 ;
        st:text "After screening, medical assessment only performed to include medical review and targeted examination, as appropriate." .

    e:u-t01-n-c4 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c4 ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "Height is at screening only. Weight on Day 1 will be collected before the start of the procedure to induce hypoglycemia." .

    e:u-t01-n-c5 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t01-n-c5-d01 ;
        st:occurrence e:t01-n-c5 ;
        st:refersToActivity e:u-t01-r012 ;
        st:text "Refer to Section 9.5.5.1." .

    e:u-t01-n-c6 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c6 ;
        st:refersToActivity e:u-t01-r013 ;
        st:text "Review patients’ insulin regimens to confirm acceptability to undergo the procedure to induce hypoglycemia." .

    e:u-t01-n-c7 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c7 ;
        st:refersToActivity e:u-t01-r014 ;
        st:text "After completion of all PK sampling, patients will be provided a carbohydrate-rich meal. The investigator will ensure the patient’s PG is stable. A prandial insulin dose will be administered if needed." .

    e:u-t01-n-c8 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c8 ;
        st:refersToActivity e:u-t01-r015 ;
        st:text "Procedures in Period 2 will occur at approximately the same time as those in Period 1. Insulin infusion is stopped once bedside PG is <60 mg/dL." .

    e:u-t01-n-c9 a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c9 ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Samples will be collected during the hypoglycemia induction procedure and post study treatment (up to 120 mins). Bedside PG monitoring will be conducted no more than 10 minutes apart while bedside PG is ≥90 mg/dL and no more than 5 minutes apart when bedside PG is <90 mg/dL." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n1 ;
        st:text "Note: if multiple procedures take place at the same time point, the following order of the procedure should be used: ECG, vital signs, and venipuncture. Plasma glucose sample should be collected as close as possible of protocol-specified time point." .

