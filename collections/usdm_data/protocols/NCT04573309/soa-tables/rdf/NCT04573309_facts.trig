    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToProperty e:u-t01-r001 ;
        st:text "Time points are relative to dosing (0 hours)." .

    e:u-t02-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-b ;
        st:refersToActivity e:u-t01-r030,
            e:u-t01-r031 ;
        st:refersToCell e:m-t01-r030-t02-c012,
            e:m-t01-r031-t02-c012 ;
        st:text "Hour 24 PK/PD sampling is to occur just prior to the next-day dose of ALXN1840." .

    e:u-t02-n-n1 a st:UnifiedAnnotation ;
        st:annotationScope "table" ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-n1 ;
        st:text "Note: Windows for PK/PD time points will be defined as ±10% of the nominal time point. On Days 1 and 39, triplicate 12-lead ECG will be collected at 4 hours postdose. When multiple procedures are scheduled to occur at the same time, the following order of events should be strictly adhered to whenever possible: ECG, vital signs, blood sampling (eg, for PK/PD), study intervention administration, and meal." .

