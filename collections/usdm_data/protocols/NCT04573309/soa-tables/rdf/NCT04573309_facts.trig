    e:u-t01-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-a-d01 ;
        st:occurrence e:t01-n-a ;
        st:refersToColumn e:u-t01-c002,
            e:u-t01-c003 ;
        st:text "Within 42 days of ALXN1840 administration. Details of procedures that may be performed by sites designated as “screening sites” (only in the US) are detailed in Section 8." .

    e:u-t01-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-b ;
        st:refersToColumn e:u-t01-c004 ;
        st:text "Participants will be admitted to the clinical research unit (CRU) at least 10 hours prior to enrollment and initiation of copper- and molybdenum-controlled diet." .

    e:u-t01-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-c ;
        st:refersToColumn e:u-t01-c013 ;
        st:text "At the CRU’s discretion, participants may remain in the CRU or be readmitted on Day 22 with all procedures starting on Day 23." .

    e:u-t01-n-d a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-d ;
        st:refersToColumn e:u-t01-c024 ;
        st:text "Unscheduled study visits may occur at any time during the study and may include any study procedure as deemed necessary by the Investigator." .

    e:u-t01-n-e a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-e ;
        st:refersToColumn e:u-t01-c025 ;
        st:text "Participants are required to return to the CRU Day 54+/-2; participants will be discontinued from ALXN1840 medication by their physician at the latest by the Day 54 follow-up." .

    e:u-t01-n-f a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-f ;
        st:refersToActivity e:u-t01-r007 ;
        st:text "Discharge from the unit may occur after completion of all procedures on Day 9 and on Day 40 and after the Investigator has reviewed all safety assessment (including safety laboratory tests) and confirmed that the participant is appropriate for discharge." .

    e:u-t01-n-g a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-g ;
        st:refersToActivity e:u-t01-r008,
            e:u-t01-r033,
            e:u-t01-r034 ;
        st:refersToCell e:m-t01-r008-t01-c013,
            e:m-t01-r033-t01-c013,
            e:m-t01-r034-t01-c013 ;
        st:text "A single outpatient visit or phone call and safety laboratory assessment should occur between Day 14 and Day 18. A phone call may take place on a different day than the blood draw within the Day 14 through Day 18 period." .

    e:u-t01-n-h a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-h ;
        st:refersToActivity e:u-t01-r011 ;
        st:text "If needed to confirm menopause." .

    e:u-t01-n-i a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-i ;
        st:refersToActivity e:u-t01-r016 ;
        st:text "Parameters include age and sex. Race and ethnicity will be collected where permitted by local regulations." .

    e:u-t01-n-j a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-j ;
        st:refersToActivity e:u-t01-r017,
            e:u-t01-r018 ;
        st:text "Wilson disease history will include diagnosis date, method of diagnosis, history of cirrhosis, details of any previous liver biopsies performed, and treatment received." .

    e:u-t01-n-k a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-k ;
        st:refersToActivity e:u-t01-r019 ;
        st:text "A full physical examination will be performed at Screening, at check-in for the study, and at the End of the study/Early Termination Visit. A physical examination should also be performed on any participants with ongoing adverse events prior to discharge from the unit. Otherwise, a symptom-driven physical examination may be performed at other times, at the Principal Investigator’s discretion." .

    e:u-t01-n-l a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-l ;
        st:refersToActivity e:u-t01-r020 ;
        st:text "Height at screening only." .

    e:u-t01-n-m a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-m ;
        st:refersToActivity e:u-t01-r025 ;
        st:text "While in the CRU, study intervention will be administered after an overnight fast (ie, at least 10 hours) at the same time every morning; drug is to be administered with 240 mL of water and meals should be delayed a minimum of 2 hours after dosing. As an outpatient, participants are expected to take ALXN1840 at approximately the same time daily (+/-1 hour). Participants should take the medication with a glass of water on an empty stomach; meals should be delayed a minimum of 2 hours after dosing." .

    e:u-t01-n-n a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-n ;
        st:refersToActivity e:u-t01-r028 ;
        st:refersToCell e:m-t01-r028-t01-c013 ;
        st:text "During the outpatient period, participants will use SMS text messaging to confirm study intervention administration." .

    e:u-t01-n-n1 a st:UnifiedAnnotation ;
        st:annotationType "placeholder" ;
        st:occurrence e:t01-n-n1 ;
        st:placeholderReason "reviewer_note" ;
        st:refersToActivity e:u-t01-r031 ;
        st:reviewNote "Reviewer note, not source content: this row prints with no marks at the top of page 15. Table 2 (page 17) prints 'Blood sampling for PK: Plasma total Mo and PUF-Mo' and 'PD: Plasma total and PUF-Cu, LBC, ceruloplasmin, ceruloplasmin-bound Cu' in one cell with one set of marks, so this row is probably the continuation of the PK row above (row 30, page 14), split by the page break. Not asserted: Table 2 covers only Days 1, 25, 29 and 39, so the PD sampling days are not stated for Table 1." ;
        st:text "" .

    e:u-t01-n-o a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-o-d01 ;
        st:occurrence e:t01-n-o ;
        st:refersToActivity e:u-t01-r029 ;
        st:text "Blood sampling for PK/PD will occur before ALXN1840 administration and represents a predose trough. See Table 2 for PK/PD sampling on Days 1, 25, 29, and 39." .

    e:u-t01-n-p a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-p-d01 ;
        st:occurrence e:t01-n-p ;
        st:refersToActivity e:u-t01-r030 ;
        st:refersToCell e:m-t01-r030-t01-c008,
            e:m-t01-r030-t01-c016,
            e:m-t01-r030-t01-c018,
            e:m-t01-r030-t01-c022 ;
        st:text "PK/PD collection will include timepoints described in the schedule of PK/PD assessment for Days 1, 25, 29, and 39 (Table 2)." .

    e:u-t01-n-q a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-q ;
        st:refersToActivity e:u-t01-r033 ;
        st:text "Samples for serum chemistry will be obtained following a fast of at least 8 hours at the Screening Visit and at check-in. In case of rechecks, and postdose serum chemistry, participants may not have fasted for 6 or 8 hours before the serum chemistry sample is taken." .

    e:u-t01-n-r a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-r ;
        st:refersToActivity e:u-t01-r033 ;
        st:refersToCell e:m-t01-r033-t01-c007,
            e:m-t01-r033-t01-c017 ;
        st:text "Laboratory assessment including chemistry, hematology, and coagulation parameters should be performed on Days -8, -1, 8, 23, and 28 only." .

    e:u-t01-n-s a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:documentReference e:u-t01-n-s-d01 ;
        st:occurrence e:t01-n-s ;
        st:refersToActivity e:u-t01-r035,
            e:u-t01-r043 ;
        st:text "Menstruation check is for women only; women of childbearing potential should only be enrolled after a negative serum pregnancy test result at Screening. Additional urine pregnancy testing will be standard for the protocol unless serum testing is required by site policies, local regulation, or Institutional Review Boards (IRBs)/Independent Ethics Committees (IECs) (Section 10.2). In addition to pregnancy tests detailed at the visits in the SoA, females of childbearing potential will be required to perform urine pregnancy tests at least every 4 weeks at their home or the study site throughout their time in the study." .

    e:u-t01-n-t a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-t ;
        st:refersToActivity e:u-t01-r036 ;
        st:text "A single 15 mL serum sample will be retained for evaluation in the event of an unexpected safety finding; retained samples may be destroyed after completion of the clinical study report." .

    e:u-t01-n-u a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-u ;
        st:refersToActivity e:u-t01-r037 ;
        st:text "Vital signs measurements and ECGs should be performed predose, unless otherwise specified. Vitals signs include body temperature, heart rate, respiratory rate, and systolic and diastolic blood pressure." .

    e:u-t01-n-v a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-v ;
        st:refersToActivity e:u-t01-r041 ;
        st:text "Copper- and molybdenum-controlled diet will be initiated after registration/inclusion. Participants will remain on a copper/molybdenum controlled diet throughout both the inpatient Period 1 (Day -8 to Day 9) and inpatient Period 2 (Day 23 to Day 40); during this time participants will be strongly encouraged to complete all meals. While not in the CRU, participants will be encouraged to adhere to their usual copper-controlled diet." .

    e:u-t01-n-w a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-w ;
        st:refersToActivity e:u-t01-r044 ;
        st:text "For each input/output balance period, 24-hour urine samples are to be collected for measurement of copper and molybdenum." .

    e:u-t01-n-x a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t01-n-x ;
        st:refersToActivity e:u-t01-r045 ;
        st:text "For fecal samples, each individual sample will be independently collected with record of date, time, and weight of the sample." .

    e:u-t01-r002 a st:UnifiedProperty ;
        st:level 2 ;
        st:member e:t01-r002 ;
        st:propertyName "Period" ;
        st:propertyType "period" .

    e:u-t01-r003 a st:UnifiedProperty ;
