    e:u-t02-n-a a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-a ;
        st:refersToColumn e:u-t02-c006 ;
        st:text "The extension period begins after study completion and ends at the end of trial." .

    e:u-t02-n-b a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-b ;
        st:refersToActivity e:u-t01-r025 ;
        st:text "Data on SAEs that occur before the end of trial will be stored in the collection database and the Lilly safety system." .

    e:u-t02-n-c a st:UnifiedAnnotation ;
        st:annotationType "footnote" ;
        st:occurrence e:t02-n-c ;
        st:refersToActivity e:u-t01-r038,
            e:u-t01-r039 ;
        st:refersToCell e:m-t01-r038-t02-c004,
            e:m-t01-r038-t02-c005,
            e:m-t01-r039-t02-c004,
            e:m-t01-r039-t02-c005 ;
        st:text "LY2835219 should be administered every 12 hours on Days 1 through 28 of each cycle. Patients should not consume food beginning 1 hour before and ending hour after taking study drug. Fulvestrant 500 mg should be administered intramuscularly into the buttocks slowly (1 to 2 minutes per injection) as two 250-mg injections, one in each buttock; however, for patients with moderate hepatic impairment (defined as Child-Pugh Class B), including any patient who develops moderate hepatic impairment during study treatment, fulvestrant 250 mg should be administered intramuscularly into the buttock slowly (1 to 2 minutes) as one 250-mg injection." .

    e:u-t02-n-pr20 a st:UnifiedAnnotation ;
        st:annotationType "source_note" ;
        st:documentReference e:u-t02-n-pr20-d01 ;
        st:occurrence e:t02-n-pr20 ;
