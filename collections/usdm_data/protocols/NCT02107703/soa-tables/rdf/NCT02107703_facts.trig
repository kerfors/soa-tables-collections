            e:u-t01-r039 ;
        st:text "Section 8.1.2" .

    e:u-t02-r004 a st:UnifiedProperty ;
        st:member e:t02-r004 ;
        st:propertyName "Duration (days)" ;
        st:propertyType "other" .

